<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        SES Energy Brand Toolkit — Spacing System
        =========================================
        A single 8px-based rhythm drives consistent, grid-aligned layouts with
        generous whitespace. "Slight corner radius only" per the brand toolkit.
    -->

    <!--#region Spacing scale (doubles) -->
    <sys:Double x:Key="SesSpaceXSmall">4</sys:Double>
    <sys:Double x:Key="SesSpaceSmall">8</sys:Double>
    <sys:Double x:Key="SesSpaceMedium">16</sys:Double>
    <sys:Double x:Key="SesSpaceLarge">24</sys:Double>
    <sys:Double x:Key="SesSpaceXLarge">32</sys:Double>
    <!--#endregion-->

    <!--#region Margin / padding thicknesses -->
    <Thickness x:Key="SesMarginXSmall">4</Thickness>
    <Thickness x:Key="SesMarginSmall">8</Thickness>
    <Thickness x:Key="SesMarginMedium">16</Thickness>
    <Thickness x:Key="SesMarginLarge">24</Thickness>

    <Thickness x:Key="SesFieldMargin">0,4,0,12</Thickness>
    <Thickness x:Key="SesButtonPadding">16,6</Thickness>
    <Thickness x:Key="SesCardPadding">16</Thickness>
    <Thickness x:Key="SesSectionPadding">24</Thickness>
    <!--#endregion-->

    <!--#region Corner radii (slight only) -->
    <CornerRadius x:Key="SesCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="SesCornerRadiusLarge">6</CornerRadius>
    <CornerRadius x:Key="SesCornerRadiusPill">14</CornerRadius>
    <!--#endregion-->

    <!--#region Control sizing -->
    <sys:Double x:Key="SesControlMinHeight">34</sys:Double>
    <sys:Double x:Key="SesButtonMinWidth">120</sys:Double>
    <sys:Double x:Key="SesGridRowMinHeight">32</sys:Double>
    <!--#endregion-->

</ResourceDictionary>
