<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MVS">

    <!--
        SES Energy Brand Toolkit — Master Dictionary
        ============================================
        Single entry point for the entire SES brand system. Merge THIS file into
        App.xaml to apply the
        full brand: colours, spacing, typography, buttons, forms and data grids.

        Order matters: colours and spacing first (foundation tokens), then
        typography, then component styles that depend on those tokens.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MVS;component/Themes/SesColors.xaml" />
        <ResourceDictionary Source="/MVS;component/Themes/SesSpacing.xaml" />
        <ResourceDictionary Source="/MVS;component/Themes/SesTypography.xaml" />
        <ResourceDictionary Source="/MVS;component/Themes/SesButtons.xaml" />
        <ResourceDictionary Source="/MVS;component/Themes/SesForms.xaml" />
        <ResourceDictionary Source="/MVS;component/Themes/SesDataGrids.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Navigation styles
        =================
        Dark Blue Grey navigation surface with Energy Green active indication,
        optimised for enterprise productivity. Kept in the master dictionary
        because it depends on tokens from several merged dictionaries above.
    -->

    <Style x:Key="SesNativeNavigationTabControlStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <DockPanel KeyboardNavigation.TabNavigation="Local">
                        <Border x:Name="NavigationRail"
                                DockPanel.Dock="Left"
                                Width="288"
                                Background="{DynamicResource SesDarkBlueGreyBrush}">
                            <DockPanel>
                                <StackPanel x:Name="RailHeading" DockPanel.Dock="Top" Margin="20,24,16,24">
                                    <TextBlock Text="MVS" FontSize="26" FontWeight="Bold"
                                               Foreground="{DynamicResource SesWhiteBrush}" />
                                    <TextBlock Text="Motion Verification System" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SesWhiteBrush}" Margin="0,6,0,0" />
                                    <TextBlock Text="NAVIGATION" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SesNavigationMutedBrush}" Margin="0,24,0,0" />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Margin="12,0,12,190">
                                    <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border x:Name="WorkspaceBorder"
                                Background="{DynamicResource SesSurfaceBrush}">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              KeyboardNavigation.TabIndex="2"
                                              KeyboardNavigation.TabNavigation="Local" />
                        </Border>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Source={x:Static local:MenuStateVM.Instance}, Path=showMenuLabels}" Value="False">
                            <Setter TargetName="NavigationRail" Property="Width" Value="80" />
                            <Setter TargetName="RailHeading" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SesNativeNavigationTabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SesTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="NavigationBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="3"
                            Margin="0,0,0,6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="NavigationHeader"
                                          ContentSource="Header"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource SesWhiteBrush}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="NavigationHeader" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="NavigationBorder" Property="BorderBrush" Value="{DynamicResource SesEnergyGreenBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="NavigationBorder" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SesDarkBlueGreyHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SesNavigationSelectedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SesNativeSubTabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Background" Value="{DynamicResource SesSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SesTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource SesBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="SubTabHeader"
                                          ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource SesTextSecondaryBrush}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource SesEnergyGreenTextBrush}" />
                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,0,2" />
                            <Setter TargetName="SubTabHeader" Property="TextElement.Foreground" Value="{DynamicResource SesEnergyGreenTextBrush}" />
                            <Setter TargetName="SubTabHeader" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource SesEnergyGreenTextBrush}" />
                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TabBorder" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SesWhiteBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SesDarkBlueGreyTintBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SesNativeWizardStepButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource SesSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SesTextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SesBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="StepButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Margin="{TemplateBinding Padding}"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="StepButtonBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Completed">
                <Setter Property="Background" Value="{DynamicResource SesEnergyGreenTintBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SesEnergyGreenTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SesEnergyGreenBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="Tag" Value="Current">
                <Setter Property="Background" Value="{DynamicResource SesDarkBlueGreyBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SesWhiteBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SesDarkBlueGreyBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource SesEnergyGreenBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Structural / surface styles
        ===========================
        Reusable card, section header and status-banner surfaces built from brand
        tokens so screens share consistent geometry and whitespace.
    -->

    <!-- Content card / panel surface -->
    <Style x:Key="SesCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SesWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SesBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource SesCornerRadiusLarge}" />
        <Setter Property="Padding" Value="{DynamicResource SesCardPadding}" />
    </Style>

    <!-- Dark Blue Grey feature / header surface -->
    <Style x:Key="SesFeatureBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SesDarkBlueGreyBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource SesCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource SesSectionPadding}" />
    </Style>

    <!-- Success / info / warning / error banner surfaces -->
    <Style x:Key="SesSuccessBadgeBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SesEnergyGreenTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SesEnergyGreenBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource SesCornerRadius}" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style x:Key="SesInfoBadgeBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SesDarkBlueGreyTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SesDarkBlueGreyBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource SesCornerRadius}" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

</ResourceDictionary>
