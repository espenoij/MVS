<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        SES Energy Brand Toolkit — Data Grids
        =====================================
        Modern, professional grids with clear row separation, Dark Blue Grey
        headers and Energy Green selected states. Brand tokens use DynamicResource
        to stay order-independent.
    -->

    <Style x:Key="SesNativeDataGridHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource SesDarkBlueGreyBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SesWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SesDarkBlueGreyPressedBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style x:Key="SesNativeDataGridRowStyle" TargetType="{x:Type DataGridRow}">
        <Setter Property="Foreground" Value="{DynamicResource SesTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SesEnergyGreenTintBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SesTextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SesSurfaceAltBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SesNativeDataGridStyle" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{DynamicResource SesWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SesBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource SesNativeDataGridHeaderStyle}" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource SesSurfaceBrush}" />
        <Setter Property="RowStyle" Value="{StaticResource SesNativeDataGridRowStyle}" />
    </Style>

</ResourceDictionary>
