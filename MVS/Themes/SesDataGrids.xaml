<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">

    <!--
        SES Energy Brand Toolkit — Data Grids
        =====================================
        Modern, professional grids with clear row separation, Dark Blue Grey
        headers and Energy Green selected states. Styles are BasedOn the Telerik
        Material defaults so control templates remain intact; only brand surface,
        text, font and selection colours are applied. Brand tokens use
        DynamicResource to stay order-independent.
    -->

    <!-- Column header: Dark Blue Grey surface, white bold text -->
    <Style x:Key="SesGridViewHeaderCellStyle" TargetType="telerik:GridViewHeaderCell" BasedOn="{StaticResource GridViewHeaderCellStyle}">
        <Setter Property="Background" Value="{DynamicResource SesDarkBlueGreyBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SesWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SesDarkBlueGreyPressedBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <!-- Data cell: brand typography and consistent padding -->
    <Style x:Key="SesGridViewCellStyle" TargetType="telerik:GridViewCell" BasedOn="{StaticResource GridViewCellStyle}">
        <Setter Property="Foreground" Value="{DynamicResource SesTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- Row: clear separation with Energy Green selected state -->
    <Style x:Key="SesGridViewRowStyle" TargetType="telerik:GridViewRow" BasedOn="{StaticResource GridViewRowStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
        <Setter Property="MinHeight" Value="{DynamicResource SesGridRowMinHeight}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SesEnergyGreenTintBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SesTextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SesSurfaceAltBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Whole grid: neutral surface, brand border and header wiring -->
    <Style x:Key="SesGridViewStyle" TargetType="telerik:RadGridView" BasedOn="{StaticResource GridViewStyle}">
        <Setter Property="Background" Value="{DynamicResource SesWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SesBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
        <Setter Property="RowIndicatorVisibility" Value="Collapsed" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="ShowGroupPanel" Value="False" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="AlternateRowBackground" Value="{DynamicResource SesSurfaceBrush}" />
        <Setter Property="RowStyle" Value="{StaticResource SesGridViewRowStyle}" />
    </Style>

</ResourceDictionary>
