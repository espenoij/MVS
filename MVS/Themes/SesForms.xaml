<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MVS.Views.Controls"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">

    <!--
        SES Energy Brand Toolkit — Forms
        ================================
        Clean labels, consistent alignment, strong spacing and clear validation.
        Positive states use Energy Green; error states stay accessible and
        professional. Brand tokens are resolved with DynamicResource.
    -->

    <!-- Form field label -->
    <Style x:Key="SesFormLabelStyle" TargetType="telerik:Label">
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SesTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,0,0,2" />
    </Style>

    <!-- Secondary / helper label -->
    <Style x:Key="SesFormHelperLabelStyle" TargetType="telerik:Label">
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeCaption}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource SesTextSecondaryBrush}" />
    </Style>

    <!-- Native form field label -->
    <Style x:Key="SesNativeFormLabelStyle" TargetType="{x:Type Label}">
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SesTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,0,0,2" />
    </Style>

    <Style x:Key="SesNativeWatermarkTextBoxStyle" TargetType="{x:Type controls:WatermarkTextBox}">
        <Setter Property="Background" Value="{DynamicResource SesSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SesTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SesBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:WatermarkTextBox}">
                    <Border
                        x:Name="TextBoxBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                            <TextBlock
                                x:Name="PART_Watermark"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Text="{TemplateBinding WatermarkContent}"
                                TextWrapping="{TemplateBinding TextWrapping}"
                                Foreground="{DynamicResource SesTextSecondaryBrush}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource SesEnergyGreenBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Native single-select field -->
    <Style x:Key="SesNativeComboBoxStyle" TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{DynamicResource SesSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SesTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SesBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
        <Setter Property="MinHeight" Value="{DynamicResource SesControlMinHeight}" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <!-- Native switch for boolean settings -->
    <Style x:Key="SesNativeToggleSwitchStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SesSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SesBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        x:Name="SwitchTrack"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="12"
                        SnapsToDevicePixels="True">
                        <Ellipse
                            x:Name="SwitchThumb"
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Left"
                            Margin="2"
                            Fill="{DynamicResource SesWhiteBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource SesEnergyGreenBrush}" />
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource SesEnergyGreenBrush}" />
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource SesDarkBlueGreyBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="SwitchTrack" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Native top-tab navigation -->
    <Style x:Key="SesNativeTabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Background" Value="{DynamicResource SesSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SesTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
        <Setter Property="Padding" Value="12,8" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SesSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SesEnergyGreenTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Native group container -->
    <Style x:Key="SesNativeGroupBoxStyle" TargetType="{x:Type GroupBox}">
        <Setter Property="Background" Value="{DynamicResource SesSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SesTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SesBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
    </Style>

    <!-- Single-line input field -->
    <Style x:Key="SesFieldTextBoxStyle" TargetType="telerik:RadWatermarkTextBox" BasedOn="{StaticResource RadWatermarkTextBoxStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource SesTextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="{DynamicResource SesControlMinHeight}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Margin" Value="{DynamicResource SesFieldMargin}" />
    </Style>

    <!-- Multi-line input field -->
    <Style x:Key="SesMultiLineFieldTextBoxStyle" TargetType="telerik:RadWatermarkTextBox" BasedOn="{StaticResource SesFieldTextBoxStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="MinHeight" Value="72" />
    </Style>

    <!-- Validation / error message text -->
    <Style x:Key="SesValidationErrorTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SesErrorBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- Validation / success message text -->
    <Style x:Key="SesValidationSuccessTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SesEnergyGreenTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

</ResourceDictionary>
