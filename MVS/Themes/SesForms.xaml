<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">

    <!--
        SES Energy Brand Toolkit — Forms
        ================================
        Clean labels, consistent alignment, strong spacing and clear validation.
        Positive states use Energy Green; error states stay accessible and
        professional. Brand tokens are resolved with DynamicResource.
    -->

    <!-- Form field label -->
    <Style x:Key="SesFormLabelStyle" TargetType="telerik:Label">
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SesTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,0,0,2" />
    </Style>

    <!-- Secondary / helper label -->
    <Style x:Key="SesFormHelperLabelStyle" TargetType="telerik:Label">
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeCaption}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource SesTextSecondaryBrush}" />
    </Style>

    <!-- Single-line input field -->
    <Style x:Key="SesFieldTextBoxStyle" TargetType="telerik:RadWatermarkTextBox" BasedOn="{StaticResource RadWatermarkTextBoxStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource SesTextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="{DynamicResource SesControlMinHeight}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Margin" Value="{DynamicResource SesFieldMargin}" />
    </Style>

    <!-- Multi-line input field -->
    <Style x:Key="SesMultiLineFieldTextBoxStyle" TargetType="telerik:RadWatermarkTextBox" BasedOn="{StaticResource SesFieldTextBoxStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="MinHeight" Value="72" />
    </Style>

    <!-- Validation / error message text -->
    <Style x:Key="SesValidationErrorTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SesErrorBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- Validation / success message text -->
    <Style x:Key="SesValidationSuccessTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource SesFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource SesFontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SesEnergyGreenTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

</ResourceDictionary>
