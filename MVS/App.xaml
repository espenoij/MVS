<Application x:Class="MVS.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MVS">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- SES Energy Brand Toolkit: colours, spacing, typography, buttons, forms, data grids, navigation -->
                <ResourceDictionary Source="/MVS;component/Themes/SesBrand.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Apply the SES brand font (Roboto Condensed, Arial fallback) to the main application window. -->
            <Style TargetType="local:MainWindow">
                <Setter Property="FontFamily" Value="{StaticResource SesFontFamily}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>