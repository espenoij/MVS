<UserControl
    x:Class="MVS.ErrorMessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="1100"
    d:DesignWidth="1900">

    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="350" />
            <ColumnDefinition
                Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="1" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0">

            <GroupBox
                Header="Filter"
                Margin="10,0,0,0"
                Style="{StaticResource SesNativeGroupBoxStyle}">
                <StackPanel>

                    <DockPanel>
                        <Label
                            Width="100"
                            Content="View"
                            VerticalAlignment="Center" />
                        <ComboBox
                            Width="auto"
                            Name="cboErrorMessageView"
                            Style="{StaticResource SesNativeComboBoxStyle}"
                            SelectionChanged="cboErrorMessageView_SelectionChanged" />
                    </DockPanel>

                    <DockPanel>
                        <Label
                            Width="100"
                            Content="Type"
                            VerticalAlignment="Center" />
                        <ComboBox
                            Width="auto"
                            Name="cboErrorMessageType"
                            Style="{StaticResource SesNativeComboBoxStyle}"
                            SelectionChanged="cboErrorMessageType_SelectionChanged" />
                    </DockPanel>

                    <DockPanel>
                        <Label
                            Width="100"
                            Content="Selection"
                            VerticalAlignment="Center" />
                        <ComboBox
                            Width="auto"
                            Name="cboErrorMessageSelection"
                            Style="{StaticResource SesNativeComboBoxStyle}"
                            SelectionChanged="cboErrorMessageSelection_SelectionChanged" />
                    </DockPanel>

                    <DockPanel>
                        <Label
                            Width="210"
                            Content="Read Messages From Database"
                            VerticalAlignment="Center" />
                        <Button
                            Name="btnReadDB"
                            Click="btnReadDB_Click"
                            Width="100"
                            HorizontalAlignment="Right"
                            Margin="5"
                            Style="{StaticResource SesNativeSecondaryButtonStyle}">Read</Button>
                    </DockPanel>

                    <DockPanel>
                        <Label
                            Width="210"
                            Content="Clear All Messages"
                            VerticalAlignment="Center" />
                        <Button
                            Name="btnClearDisplay"
                            Click="btnClearDisplay_Click"
                            Width="100"
                            HorizontalAlignment="Right"
                            Margin="5"
                            Style="{StaticResource SesNativeSecondaryButtonStyle}">Clear</Button>
                    </DockPanel>

                    <DockPanel>
                        <Label
                            Width="210"
                            Content="Copy to Clipboard"
                            VerticalAlignment="Center" />
                        <Button
                            Name="btnCopyToClipboard"
                            Click="btnCopyToClipboard_Click"
                            Width="100"
                            HorizontalAlignment="Right"
                            Margin="5"
                            Style="{StaticResource SesNativeSecondaryButtonStyle}">Copy</Button>
                    </DockPanel>

                </StackPanel>

            </GroupBox>

            <GroupBox
                Header="Database"
                Margin="10,0,0,0"
                Style="{StaticResource SesNativeGroupBoxStyle}">
                <StackPanel>

                    <DockPanel>
                        <Label
                            Width="180"
                            Content="Delete All Error Messages"
                            VerticalAlignment="Center" />
                        <Button
                            Name="btnDeleteAllErrorMessages"
                            Click="btnDeleteAllErrorMessages_Click"
                            Width="80"
                            HorizontalAlignment="Right"
                            Margin="5,10,5,5"
                            Style="{StaticResource SesNativeSecondaryButtonStyle}">Delete</Button>
                    </DockPanel>

                </StackPanel>

            </GroupBox>

        </StackPanel>

        <!--Error Message Data-->
        <GroupBox
            Grid.Row="0"
            Grid.Column="1"
            Header="Error Messages"
            Margin="10,0,10,10"
            Style="{StaticResource SesNativeGroupBoxStyle}">

            <DockPanel>

                <DataGrid
                    Name="lvErrorMessagesData"
                    IsReadOnly="True"
                    IsManipulationEnabled="False"
                    CanUserSortColumns="False"
                    CanUserAddRows="False"
                    HeadersVisibility="None"
                    RowHeight="25"
                    Margin="0,5,0,0"
                    Background="{StaticResource SesSurfaceBrush}"
                    Foreground="{StaticResource SesTextPrimaryBrush}"
                    BorderBrush="{StaticResource SesBorderBrush}"
                    HorizontalGridLinesBrush="{StaticResource SesBorderBrush}"
                    GridLinesVisibility="Horizontal"
                    CanUserReorderColumns="False"
                    CanUserDeleteRows="False"
                    RowHeaderWidth="0"
                    SelectionMode="Extended"
                    SelectionUnit="FullRow"
                    AutoGenerateColumns="False">

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Header="Timestamp"
                            Width="180"
                            Binding="{Binding timestampString}" />
                        <DataGridTextColumn
                            Header="ID"
                            Width="40"
                            Binding="{Binding idString}" />
                        <DataGridTextColumn
                            Header="Type"
                            Width="80"
                            Binding="{Binding typeString}" />
                        <DataGridTextColumn
                            Header="Message"
                            Width="auto"
                            Binding="{Binding message}" />
                    </DataGrid.Columns>

                </DataGrid>

            </DockPanel>

        </GroupBox>

    </Grid>

</UserControl>
