<UserControl
    x:Class="MVS.MVSOutput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="1100"
    d:DesignWidth="1900">

    <UserControl.Resources>
        <Style
            x:Key="DataStatusColorCode"
            TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="{StaticResource SesSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SesTextPrimaryBrush}" />
            <Style.Triggers>

                <DataTrigger
                    Binding="{Binding Path=statusString}"
                    Value="TIMEOUT_ERROR">
                    <Setter
                        Property="Background"
                        Value="{StaticResource ColorAmber}" />
                </DataTrigger>

                <DataTrigger
                    Binding="{Binding Path=statusString}"
                    Value="OK">
                    <Setter
                        Property="Background"
                        Value="{StaticResource ColorGreen}" />
                </DataTrigger>

                <DataTrigger
                    Binding="{Binding Path=statusString}"
                    Value="OK_NA">
                    <Setter
                        Property="Background"
                        Value="{StaticResource ColorGreen}" />
                </DataTrigger>

            </Style.Triggers>
        </Style>
        <Style
            x:Key="MvsOutputDataGridColumnHeaderStyle"
            TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource SesSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SesTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SesBorderBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </UserControl.Resources>

    <GroupBox
        Style="{StaticResource SesNativeGroupBoxStyle}"
        Header="MVS OUTPUT"
        Grid.Column="2"
        Margin="8">

        <DataGrid
            DockPanel.Dock="Left"
            Name="gvMVSOutputData"
            Margin="0,8,0,0"
            RowStyle="{StaticResource DataStatusColorCode}"
            ColumnHeaderStyle="{StaticResource MvsOutputDataGridColumnHeaderStyle}"
            Background="{StaticResource SesSurfaceBrush}"
            Foreground="{StaticResource SesTextPrimaryBrush}"
            BorderBrush="{StaticResource SesBorderBrush}"
            BorderThickness="1"
            HorizontalGridLinesBrush="{StaticResource SesBorderBrush}"
            VerticalGridLinesBrush="{StaticResource SesBorderBrush}"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            RowHeaderWidth="0"
            IsManipulationEnabled="False"
            CanUserSortColumns="True"
            CanUserReorderColumns="False"
            CanUserDeleteRows="False"
            IsReadOnly="True"
            SelectionMode="Single"
            SelectionUnit="FullRow"
            AutoGenerateColumns="False">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Width="2*"
                    Header="Name"
                    IsReadOnly="True"
                    Binding="{Binding name}" />
                <DataGridTextColumn
                    Width="*"
                    Header="Data"
                    IsReadOnly="True"
                    Binding="{Binding dataString}" />
                <DataGridTextColumn
                    Width="*"
                    Header="ID"
                    IsReadOnly="True"
                    Binding="{Binding id}" />
                <DataGridTextColumn
                    Width="*"
                    Header="Status"
                    IsReadOnly="True"
                    Binding="{Binding statusString}" />

            </DataGrid.Columns>

        </DataGrid>

    </GroupBox>

</UserControl>
