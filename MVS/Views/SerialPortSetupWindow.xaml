                                            Binding="{Binding dataField[59]}" />

                                    </DataGrid.Columns>

                                </DataGrid>

                            </DockPanel>

                        </GroupBox>

                        <!--Selected Data-->
                        <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                            Grid.Column="0"
                            Grid.Row="2"
                            Header="Selected Data"
                            Margin="8">

                            <DockPanel>

                                <DataGrid
                                    Name="lvSelectedData"
                                    Style="{StaticResource SesNativeDataGridStyle}"
                                    IsReadOnly="True"
                                    IsManipulationEnabled="False"
                                    CanUserSortColumns="False"
                                    HeadersVisibility="None"
                                    RowHeight="25"
                                    Margin="8"
                                    CanUserReorderColumns="False"
                                    CanUserDeleteRows="False"
                                    SelectionUnit="FullRow"
                                    AutoGenerateColumns="False">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Binding="{Binding selectedDataFieldString}" />
                                    </DataGrid.Columns>

                                </DataGrid>

                            </DockPanel>

                        </GroupBox>

                        <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                            Grid.Column="1"
                            Grid.Row="0"
                            Header="Data Field Split"
                            Margin="8">

                            <StackPanel
                                Margin="8">

                                <DockPanel>
                                    <Label
                                        Name="lbPacketDataDelimiter"
                                        Width="160"
                                        Content="Delimiter"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Name="tbPacketDataDelimiter"
                                        LostFocus="tbPacketDataDelimiter_LostFocus"
                                        KeyDown="tbPacketDataDelimiter_KeyDown"/>
                                </DockPanel>

                                <DockPanel>
                                    <Label
                                        Name="lbCombineFields"
                                        Width="160"
                                        Content="Combine Fields"
                                        VerticalAlignment="Center" />
                                    <ComboBox
                                        Name="cboCombineFields"
                                        SelectionChanged="cboCombineFields_SelectionChanged" />
                                </DockPanel>

                                <Separator
                                    Margin="0,8" />

                                <CheckBox
                                    Name="cboFixedPositionData"
                                    Content="Fixed Position Data"
                                    Checked="cboFixedPositionData_Checked"
                                    Unchecked="cboFixedPositionData_Unchecked" />

                                <DockPanel>
                                    <Label
                                        Name="lblFixedPositionDataStart"
                                        Width="160"
                                        Content="Start"
                                        VerticalAlignment="Center" />
