                                        Name="lbSelectedDataBytesInValue"
                                        Width="160"
                                        Content="Binary Type"
                                        VerticalAlignment="Center" />
                                    <ComboBox
                                        Name="cboSelectedDataBytesInValue"
                                        SelectionChanged="cboSelectedDataBytesInValue_SelectionChanged" />
                                </DockPanel>

