<Window
    x:Class="MVS.SerialPortSetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:MVS"
    mc:Ignorable="d"
    Title="Serial Port Data Setup"
    WindowState="Maximized"
    Closed="Window_Closed"
    Height="1010"
    Width="1600"
    Icon="pack://application:,,,/MVS;component/Icons/mvs_windows_icon.ico">

    <DockPanel>

        <!--Status Bar-->
        <StatusBar
            DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock
                    Name="sensorMonitorStatus" />
            </StatusBarItem>
        </StatusBar>

        <Grid
            DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="2*" />
                <ColumnDefinition
                    Width="5*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer>

                <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Margin="8">

                    <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                    Header="Basic Information"
                    Margin="8">

                        <StackPanel>

                            <DockPanel>
                                <Label
                                Width="80"
                                Content="ID" />
                                <Label
                                Name="lbSensorID" />
                            </DockPanel>

                            <DockPanel>
                                <Label
                                Width="80"
                                Content="Name"
                                VerticalAlignment="Center" />
                                <Label
                                Name="lbSensorName" />
                            </DockPanel>

                            <DockPanel>
                                <Label
                                Width="80"
                                Content="Type"
                                VerticalAlignment="Center" />
                                <Label
                                Name="lbSensorType" />
                            </DockPanel>

                        </StackPanel>

                    </GroupBox>

                    <!--Serial Port Configuration-->
                    <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                    Header="Connection"
                    Margin="8">
                        <StackPanel>

                            <DockPanel>
                                <Label
                                Width="90"
                                Content="Port Name"
                                VerticalAlignment="Center" />
                                <ComboBox
                                Width="auto"
                                Name="cboPortName"
                                SelectionChanged="cboCOMPort_SelectionChanged" />
                            </DockPanel>

                            <DockPanel>
                                <Label
                                Width="90"
                                Content="Baud Rate"
                                VerticalAlignment="Center" />
                                <ComboBox
                                Width="auto"
                                Name="cboBaudRate"
                                SelectionChanged="cboBaudRate_SelectionChanged" />
                            </DockPanel>

                            <DockPanel>
                                <Label
                                Width="90"
                                Content="Data Bits"
                                VerticalAlignment="Center" />
                                <ComboBox
                                Width="auto"
                                Name="cboDataBits"
                                SelectionChanged="cboDataBits_SelectionChanged" />
                            </DockPanel>

                            <DockPanel>
                                <Label
                                Width="90"
                                Content="Stop Bits"
                                VerticalAlignment="Center" />
                                <ComboBox
                                Width="auto"
                                Name="cboStopBits"
                                SelectionChanged="cboStopBits_SelectionChanged" />
                            </DockPanel>

                            <DockPanel>
                                <Label
                                Width="90"
                                Content="Data Parity"
                                VerticalAlignment="Center" />
                                <ComboBox
                                Width="auto"
                                Name="cboParity"
                                SelectionChanged="cboDataParity_SelectionChanged" />
                            </DockPanel>

                            <DockPanel>
                                <Label
                                Width="90"
                                Content="Hand Shake"
                                VerticalAlignment="Center" />
                                <ComboBox
                                Width="auto"
                                Name="cboHandShake"
                                SelectionChanged="cboHandShake_SelectionChanged" />
                            </DockPanel>

                        </StackPanel>
                    </GroupBox>

                    <!--Serial Port Controls-->
                    <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                    Header="Connection Controls"
                    Margin="8">

                        <StackPanel>
                            <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                                <Button
                                x:Name="btnSerialPortReaderStart"
                                Click="btnSerialPortReaderOpen_Click"
                                Width="100"
                                Margin="8"
                                Content="Open" />
                                <Button
                                x:Name="btnSerialPortReaderStop"
                                Click="btnSerialPortReaderClose_Click"
                                Width="100"
                                Margin="8"
                                IsEnabled="False"
                                Content="Close" />

                            </StackPanel>

                            <Rectangle
                            Width="auto"
                            Height="7"
                            Margin="8">
                                <Rectangle.Fill>
                                    <VisualBrush
                                    Stretch="None">
                                        <VisualBrush.Visual>
                                            <Border
                                            x:Name="bSerialPortStatus"
                                            CornerRadius="3,3,3,3"
                                            Width="120"
                                            Height="7"
                                            Background="{StaticResource ColorRed}"
                                            BorderThickness="1"
                                            BorderBrush="Gray" />
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                        </StackPanel>

                    </GroupBox>

                    <!--Data Display-->
                    <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                    Header="Sensor Output"
                    Margin="8">

                        <StackPanel>

                            <DockPanel>
                                <Label
                                Width="90"
                                Content="Data Type"
                                VerticalAlignment="Center" />
                                <ComboBox
                                Name="cboSensorDataType"
                                SelectionChanged="cboSensorDataType_SelectionChanged" />
                            </DockPanel>

                        </StackPanel>

                    </GroupBox>

                    <!--Data Display-->
                    <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                    Header="Data Display"
                    Margin="8">

                        <StackPanel>

                            <DockPanel>

                                <Label
                                Width="90"
                                Content="Data Lines"
                                VerticalAlignment="Center" />

                                <TextBox
                                Name="tbDataLines"
                                Text="{Binding totalDataLinesString}"
                                LostFocus="tbDataLines_LostFocus"
                                KeyDown="tbDataLines_KeyDown" />

                            </DockPanel>

                            <CheckBox
                            x:Name="chkShowControlChars"
                            Checked="chkShowControlChars_Checked"
                            Unchecked="chkShowControlChars_Unchecked"
                            Content="Show Control Chars" />

                            <Button
                            x:Name="chkRawDataAllClear"
                            Click="chkRawDataAllClear_Click"
                            HorizontalAlignment="Left"
                            Content="Clear All" />

                        </StackPanel>

                    </GroupBox>

                </StackPanel>

            </ScrollViewer>

            <TabControl
                Grid.Row="0"
                Grid.Column="1"
                Margin="8">

                <!--1. Packet Selection-->
                <TabItem
                    Name="tabPacketSelection"
                    Header="1: Packet Selection">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="10*" />
                            <ColumnDefinition
                                Width="8*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="*" />
                            <RowDefinition
                                Height="*" />
                        </Grid.RowDefinitions>

                        <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                            Header="Raw Data"
                            Grid.Column="0"
                            Grid.Row="0"
                            Margin="8">

                            <DataGrid
                                Name="lvRawData"
                                IsReadOnly="True"
                                IsManipulationEnabled="False"
                                CanUserSortColumns="False"
                                HeadersVisibility="None"
                                RowHeight="25"
                                Margin="8"
                                CanUserReorderColumns="False"
                                CanUserDeleteRows="False"
                                Background="{StaticResource SesSurfaceBrush}"
                                Foreground="{StaticResource SesTextPrimaryBrush}"
                                BorderBrush="{StaticResource SesBorderBrush}"
                                HorizontalGridLinesBrush="{StaticResource SesBorderBrush}"
                                GridLinesVisibility="Horizontal"
                                AutoGenerateColumns="False">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding data}" />
                                </DataGrid.Columns>

                            </DataGrid>

                        </GroupBox>

                        <!--SelectedPacket-->
                        <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                            Header="Selected Packets"
                            Grid.Column="0"
                            Grid.Row="1"
                            Margin="8">

                            <DataGrid
                                Name="lvSelectedPackets"
                                IsReadOnly="True"
                                IsManipulationEnabled="False"
                                CanUserSortColumns="False"
                                HeadersVisibility="None"
                                RowHeight="25"
                                Margin="8"
                                CanUserReorderColumns="False"
                                CanUserDeleteRows="False"
                                Background="{StaticResource SesSurfaceBrush}"
                                Foreground="{StaticResource SesTextPrimaryBrush}"
                                BorderBrush="{StaticResource SesBorderBrush}"
                                HorizontalGridLinesBrush="{StaticResource SesBorderBrush}"
                                GridLinesVisibility="Horizontal"
                                AutoGenerateColumns="False">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding data}" />
                                </DataGrid.Columns>

                            </DataGrid>

                        </GroupBox>

                        <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                            Grid.Column="1"
                            Grid.Row="0"
                            Header="Packet Selection"
                            Margin="8">

                            <StackPanel
                                Margin="8">

                                <DockPanel>
                                    <Label
                                        Width="140"
                                        Content="Packet Header"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Name="tbSelectedPacketHeader"
                                        LostFocus="tbSelectedPacketHeader_LostFocus"
                                        KeyDown="tbSelectedPacketHeader_KeyDown"/>
                                </DockPanel>

                                <DockPanel>
                                    <Label
                                        Width="140"
                                        Content="Packet End"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Name="tbSelectedPacketEnd"
                                        LostFocus="tbSelectedPacketEnd_LostFocus"
                                        KeyDown="tbSelectedPacketEnd_KeyDown"/>
                                </DockPanel>

                            </StackPanel>

                        </GroupBox>

                    </Grid>

                </TabItem>

                <!--2. Data Selection-->
                <TabItem
                    Name="tabDataSelection"
                    Header="2: Data Selection">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="10*" />
                            <ColumnDefinition
                                Width="8*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="*" />
                            <RowDefinition
                                Height="*" />
                            <RowDefinition
                                Height="*" />
                        </Grid.RowDefinitions>

                        <!--SelectedPacket-->
                        <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                            Header="Selected Packets"
                            Grid.Column="0"
                            Grid.Row="0"
                            Margin="8">

                            <DockPanel>

                                <DataGrid
                                    Name="lvSelectedPackets2"
                                    IsReadOnly="True"
                                    IsManipulationEnabled="False"
                                    CanUserSortColumns="False"
                                    HeadersVisibility="None"
                                    RowHeight="25"
                                    Margin="8"
                                    CanUserReorderColumns="False"
                                    CanUserDeleteRows="False"
                                    Background="{StaticResource SesSurfaceBrush}"
                                    Foreground="{StaticResource SesTextPrimaryBrush}"
                                    BorderBrush="{StaticResource SesBorderBrush}"
                                    HorizontalGridLinesBrush="{StaticResource SesBorderBrush}"
                                    GridLinesVisibility="Horizontal"
                                    AutoGenerateColumns="False">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding data}" />
                                    </DataGrid.Columns>

                                </DataGrid>

                            </DockPanel>

                        </GroupBox>

                        <!--Data Fields-->
                        <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                            Header="Data Fields"
                            Grid.Column="0"
                            Grid.Row="1"
                            Margin="8">

                            <DockPanel>

                                <DataGrid
                                    Name="lvPacketData"
                                    Style="{StaticResource SesNativeDataGridStyle}"
                                    IsReadOnly="True"
                                    IsManipulationEnabled="False"
                                    CanUserSortColumns="False"
                                    HeadersVisibility="Column"
                                    RowHeight="25"
                                    Margin="8"
                                    CanUserReorderColumns="False"
                                    CanUserDeleteRows="False"
                                    SelectionUnit="FullRow"
                                    AutoGenerateColumns="False">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Header="0"
                                            Width="140"
                                            Binding="{Binding dataField[0]}" />
                                        <DataGridTextColumn
                                            Header="1"
                                            Width="140"
                                            Binding="{Binding dataField[1]}" />
                                        <DataGridTextColumn
                                            Header="2"
                                            Width="140"
                                            Binding="{Binding dataField[2]}" />
