                        <!--Data Selection-->
                        <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                            Header="Data Selection"
                            Grid.Column="1"
                            Grid.Row="1"
                            Margin="8">

                            <StackPanel
                                Margin="8">

                                <!--Selected Data Field-->
                                <DockPanel>
                                    <Label
                                        Width="160"
                                        Content="Data Field"
                                        VerticalAlignment="Center" />
                                    <ComboBox
                                        Name="cboSelectedDataField"
                                        SelectionChanged="cboSelectedDataField_SelectionChanged" />
