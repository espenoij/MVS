                </TabItem>

                <!--3. Data Calculations-->
                <TabItem
                    Name="tabDataCalculations"
                    Header="3: Data Calculations">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="10*" />
                            <ColumnDefinition
                                Width="8*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="*" />
                            <RowDefinition
                                Height="*" />
                        </Grid.RowDefinitions>

                        <!--Selected Data-->
                        <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                            Grid.Column="0"
                            Grid.Row="0"
                            Header="Selected Data"
                            Margin="8">

                            <DataGrid
                                Name="lvSelectedData2"
                                Style="{StaticResource SesNativeDataGridStyle}"
                                IsReadOnly="True"
                                IsManipulationEnabled="False"
                                CanUserSortColumns="False"
                                HeadersVisibility="None"
                                RowHeight="25"
                                Margin="8"
                                CanUserReorderColumns="False"
                                CanUserDeleteRows="False"
                                SelectionUnit="FullRow"
                                AutoGenerateColumns="False">

                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Binding="{Binding selectedDataFieldString}" />
                                </DataGrid.Columns>

                            </DataGrid>

                        </GroupBox>

                        <!--Calculated Data-->
                        <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                            Grid.Column="0"
                            Grid.Row="1"
                            Header="Calculated Data"
                            Margin="8">

                            <DataGrid
                                Name="lvCalculatedData"
                                Style="{StaticResource SesNativeDataGridStyle}"
                                IsReadOnly="True"
                                IsManipulationEnabled="False"
                                CanUserSortColumns="False"
                                HeadersVisibility="None"
                                RowHeight="25"
                                Margin="8"
                                CanUserReorderColumns="False"
