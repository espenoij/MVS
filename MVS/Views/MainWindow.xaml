<Window
    x:Class="MVS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Closed="Window_Closing"
    Title="Motion Verification System"
    xmlns:uc="clr-namespace:MVS"
    WindowState="Maximized"
    Height="800"
    Width="1200"
    Icon="pack://application:,,,/MVS;component/Icons/mvs_windows_icon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style
            x:Key="SensorDataColorCode"
            TargetType="{x:Type DataGridRow}"
            BasedOn="{StaticResource SesNativeDataGridRowStyle}">
            <Style.Triggers>

                <DataTrigger
                    Binding="{Binding portStatusString}"
                    Value="Reading">
                    <Setter
                        Property="Background"
                        Value="{StaticResource ColorGreen}" />
                </DataTrigger>

                <DataTrigger
                    Binding="{Binding portStatusString}"
                    Value="NoData">
                    <Setter
                        Property="Background"
                        Value="{StaticResource ColorAmber}" />
                </DataTrigger>

                <DataTrigger
                    Binding="{Binding portStatusString}"
                    Value="Warning">
                    <Setter
                        Property="Background"
                        Value="{StaticResource ColorAmber}" />
                </DataTrigger>

                <DataTrigger
                    Binding="{Binding portStatusString}"
                    Value="OpenError">
                    <Setter
                        Property="Background"
                        Value="{StaticResource ColorRed}" />
                </DataTrigger>

                <DataTrigger
                    Binding="{Binding portStatusString}"
                    Value="EndOfFile">
                    <Setter
                        Property="Background"
                        Value="{StaticResource ColorAmber}" />
                </DataTrigger>

            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource SesSurfaceBrush}">

        <DockPanel>

            <!--Application restart warning-->
            <DockPanel
                Name="dpApplicationRestartRequired"
                Visibility="Collapsed"
                DockPanel.Dock="Top"
                Background="{StaticResource ColorRed}">

                <TextBlock
                    Margin="8"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    Text="A restart of the application is required to enable new settings." />

            </DockPanel>

            <!--Database Status-->
            <DockPanel
                 Name="tbDatabaseStatus"
                 Visibility="Collapsed"
                 DockPanel.Dock="Top"
                 Background="{StaticResource ColorAmber}">

                <TextBlock
                    x:Name="tbDatabaseStatusText"
                    HorizontalAlignment="Center" />

            </DockPanel>

            <TabControl
                DockPanel.Dock="Top"
                Name="tcMainMenu"
                TabStripPlacement="Left"
                Style="{StaticResource SesNativeNavigationTabControlStyle}"
                Background="{StaticResource ColorVerticalBarBackground}"
                SelectionChanged="tcMainMenu_SelectionChanged">


                <!--==============================================================-->
                <!--Side Menu: Projects-->
                <!--==============================================================-->
                <TabItem Style="{StaticResource SesNativeNavigationTabItemStyle}"
                    Name="tabProjects"
                    Header="Projects">

                    <TabItem.HeaderTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Grid.Column="0"
                                    Width="18"
                                    HorizontalAlignment="Center"
                                    Source="../Icons/outline_addchart_white_48dp.png" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding}"
                                    Foreground="{StaticResource SesWhiteBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding Source={x:Static uc:MenuStateVM.Instance}, Path=showMenuLabels, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </TabItem.HeaderTemplate>

                    <uc:Projects
                        x:Name="ucProjects" />

                </TabItem>

                <!--==============================================================-->
                <!--Side Menu: Sensor Input-->
                <!--==============================================================-->
                <TabItem Style="{StaticResource SesNativeNavigationTabItemStyle}"
                    Name="tabInput"
                    Header="Input">

                    <TabItem.HeaderTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Grid.Column="0"
                                    Width="18"
                                    HorizontalAlignment="Center"
                                    Source="../Icons/input_white_36dp.png" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding}"
                                    Foreground="{StaticResource SesWhiteBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding Source={x:Static uc:MenuStateVM.Instance}, Path=showMenuLabels, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </TabItem.HeaderTemplate>

                    <DockPanel>

                        <Grid
                            DockPanel.Dock="Top">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--Selected Project-->
                            <Label
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                FontSize="{StaticResource fontSizeProject}"
                                Content="{Binding SelectedProjectString}" />

                            <!--Top Buttons & Header-->
                            <StackPanel
                                Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="8">

                                <Button
                                    Click="btnStart_Click"
                                    IsEnabled="{Binding StartButtonEnabled}"
                                    Width="140"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource SesNativePrimaryButtonStyle}">Start Recording</Button>

                            </StackPanel>

                        </Grid>

                        <TabControl
                            DockPanel.Dock="Top"
                            Background="{StaticResource SesSurfaceBrush}"
                            Margin="8,0,8,8">

                            <TabItem Style="{StaticResource SesNativeSubTabItemStyle}"
                                Name="tabInput_Status"
                                Header="Status">

                                <DockPanel>

                                    <DataGrid
                                        Name="gvStatusDisplay"
                                        Style="{StaticResource SesNativeDataGridStyle}"
                                        ItemsSource="{Binding SensorData}"
                                        RowStyle="{StaticResource SensorDataColorCode}"
                                        IsReadOnly="True"
                                        IsManipulationEnabled="False"
                                        CanUserSortColumns="True"
                                        CanUserReorderColumns="False"
                                        CanUserDeleteRows="False"
                                        AutoGenerateColumns="False"
                                        SelectionUnit="FullRow"
                                        SelectionChanged="gvStatusDisplay_SelectionChanged"
                                        Margin="-1,0,1,0">

                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="120"
                                                Header="Type"
                                                Binding="{Binding type}" />
                                            <DataGridTextColumn
                                                Width="150"
                                                Header="Source"
                                                Binding="{Binding source}" />
                                            <DataGridTextColumn
                                                Width="300"
                                                Header="Name"
                                                Binding="{Binding name}" />
                                            <DataGridTextColumn
                                                Width="100"
                                                Header="Status"
                                                Binding="{Binding portStatusString}" />
                                            <DataGridTextColumn
                                                Width="*"
                                                Header="Message"
                                                Binding="{Binding messageSingleLine}" />
                                        </DataGrid.Columns>

                                    </DataGrid>
                                </DockPanel>
                            </TabItem>

                            <TabItem Style="{StaticResource SesNativeSubTabItemStyle}"
                                Name="tabInput_SensorData"
                                Header="Sensor Data"
                                Visibility="Collapsed">

                                <DataGrid
                                    Name="gvSensorDataDisplay"
                                    Style="{StaticResource SesNativeDataGridStyle}"
                                    RowStyle="{StaticResource SensorDataColorCode}"
                                    IsReadOnly="True"
                                    IsManipulationEnabled="False"
                                    CanUserReorderColumns="False"
                                    SelectionUnit="FullRow"
                                    AutoGenerateColumns="False"
                                    SelectionMode="Single"
                                    SelectionChanged="gvSensorDataDisplay_SelectionChanged"
                                    Margin="-1,0,1,0">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="80"
                                            Header="ID"
                                            Binding="{Binding id}" />
                                        <DataGridTextColumn
                                            Width="120"
                                            Header="Type"
                                            Binding="{Binding type}" />
                                        <DataGridTextColumn
                                            Width="250"
                                            Header="Source"
                                            Binding="{Binding source}" />
                                        <DataGridTextColumn
                                            Width="300"
                                            Header="Name"
                                            Binding="{Binding name}" />
                                        <DataGridTextColumn
                                            Width="100"
                                            Header="Status"
                                            Binding="{Binding portStatus}" />
                                        <DataGridTextColumn
                                            Width="200"
                                            Header="Time Stamp"
                                            Binding="{Binding timestampString}" />
                                        <DataGridTextColumn
                                            Width="*"
                                            Header="Data"
                                            Binding="{Binding data}" />
                                    </DataGrid.Columns>

                                </DataGrid>

                            </TabItem>

                            <TabItem Style="{StaticResource SesNativeSubTabItemStyle}"
                                Name="tabInput_SerialData"
                                Header="Serial Ports"
                                Visibility="Collapsed">

                                <DataGrid
                                    Name="gvSerialPortDataDisplay"
                                    Style="{StaticResource SesNativeDataGridStyle}"
                                    RowStyle="{StaticResource SensorDataColorCode}"
                                    IsReadOnly="True"
                                    IsManipulationEnabled="False"
                                    CanUserReorderColumns="False"
                                    AutoGenerateColumns="False"
                                    SelectionUnit="FullRow"
                                    SelectionChanged="gvNonSelectableDataGrid_SelectionChanged"
                                    Margin="-1,0,1,0">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="140"
                                            Header="Port Name"
                                            Binding="{Binding portName}" />
                                        <DataGridTextColumn
                                            Width="100"
                                            Header="Status"
                                            Binding="{Binding portStatusString}" />
                                        <DataGridTextColumn
                                            Width="200"
                                            Header="Time Stamp"
                                            Binding="{Binding timestampString}" />
                                        <DataGridTextColumn
                                            Width="*"
                                            Header="Data"
                                            Binding="{Binding buffer_text}" />
                                    </DataGrid.Columns>

                                </DataGrid>

                            </TabItem>

                            <TabItem Style="{StaticResource SesNativeSubTabItemStyle}"
                                Name="tabInput_FileReader"
                                Header="File Reader"
                                Visibility="Collapsed">

                                <DataGrid
                                    Name="gvFileReaderDataDisplay"
                                    Style="{StaticResource SesNativeDataGridStyle}"
                                    RowStyle="{StaticResource SensorDataColorCode}"
                                    IsReadOnly="True"
                                    IsManipulationEnabled="False"
                                    CanUserReorderColumns="False"
                                    AutoGenerateColumns="False"
                                    SelectionUnit="FullRow"
                                    SelectionChanged="gvNonSelectableDataGrid_SelectionChanged"
                                    Margin="-1,0,1,0">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="600"
                                            Header="Port Name"
                                            Binding="{Binding filePath}" />
                                        <DataGridTextColumn
                                            Width="100"
                                            Header="Status"
                                            Binding="{Binding portStatus}" />
                                        <DataGridTextColumn
                                            Width="200"
                                            Header="Time Stamp"
                                            Binding="{Binding timestampString}" />
                                        <DataGridTextColumn
                                            Width="*"
                                            Header="Data"
                                            Binding="{Binding dataLine}" />
                                    </DataGrid.Columns>

                                </DataGrid>

                            </TabItem>

                            <TabItem Style="{StaticResource SesNativeSubTabItemStyle}"
                                Name="tabInput_FixedValue"
                                Header="Fixed Value"
                                Visibility="Collapsed">

                                <DataGrid
                                    Name="gvFixedValueDataDisplay"
                                    Style="{StaticResource SesNativeDataGridStyle}"
                                    RowStyle="{StaticResource SensorDataColorCode}"
                                    IsReadOnly="True"
                                    IsManipulationEnabled="False"
                                    CanUserReorderColumns="False"
                                    AutoGenerateColumns="False"
                                    SelectionUnit="FullRow"
                                    SelectionChanged="gvNonSelectableDataGrid_SelectionChanged"
                                    Margin="-1,0,1,0">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="80"
                                            Header="ID"
                                            Binding="{Binding id}" />
                                        <DataGridTextColumn
                                            Width="100"
                                            Header="Status"
                                            Binding="{Binding portStatus}" />
                                        <DataGridTextColumn
                                            Width="200"
                                            Header="Time Stamp"
                                            Binding="{Binding timestampString}" />
                                        <DataGridTextColumn
                                            Width="*"
                                            Header="Data"
                                            Binding="{Binding value}" />
                                    </DataGrid.Columns>

                                </DataGrid>

                            </TabItem>

                        </TabControl>

                    </DockPanel>

                </TabItem>

                <!--==============================================================-->
                <!--Side Menu: LiDAR Helideck Calibration (moved into Projects wizard step 2)-->
                <!--==============================================================-->
                <!--
                <TabItem Style="{StaticResource SesNativeNavigationTabItemStyle}"
                    Name="tabLivoxLidar"
                    Header="LiDAR">

                    <TabItem.HeaderTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Grid.Column="0"
                                    Width="18"
                                    HorizontalAlignment="Center"
                                    Source="../Icons/detector_white_36dp.png" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding}"
                                    Foreground="{StaticResource SesWhiteBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding Source={x:Static uc:MenuStateVM.Instance}, Path=showMenuLabels, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </TabItem.HeaderTemplate>

                    <uc:LivoxLidarPage
                        x:Name="ucLivoxLidarPage" />

                </TabItem>
                -->

                <!--==============================================================-->
                <!--Side Menu: Input Setup-->
                <!--==============================================================-->
                <TabItem Style="{StaticResource SesNativeNavigationTabItemStyle}"
                    Name="tabInputSetup"
                    Visibility="Collapsed"
                    Header="Setup">

                    <TabItem.HeaderTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Grid.Column="0"
                                    Width="18"
                                    HorizontalAlignment="Center"
                                    Source="../Icons/input_edit_white_36dp.png" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding}"
                                    Foreground="{StaticResource SesWhiteBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding Source={x:Static uc:MenuStateVM.Instance}, Path=showMenuLabels, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </TabItem.HeaderTemplate>

                    <DockPanel>

                        <Grid
                            DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--Selected Project-->
                            <Label
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                FontSize="{StaticResource fontSizeProject}"
                                Content="{Binding SelectedProjectString}" />

                            <!--Top Buttons & Header-->
                            <StackPanel
                                Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="8">

                                <Button
                                    Click="btnStart_Click"
                                    IsEnabled="{Binding StartButtonEnabled}"
                                    Width="140"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource SesNativePrimaryButtonStyle}">Start Recording</Button>

                            </StackPanel>

                        </Grid>

                        <TabControl
                            DockPanel.Dock="Top"
                            Background="{StaticResource SesSurfaceBrush}"
                            Margin="8,0,8,8">

                            <TabItem Style="{StaticResource SesNativeSubTabItemStyle}"
                                Name="tabSensorSetup"
                                Header="Sensor Setup">

                                <DockPanel>

                                    <uc:SensorSetupPage
                                        x:Name="ucSensorSetupPage" />

                                </DockPanel>

                            </TabItem>

                            <TabItem Style="{StaticResource SesNativeSubTabItemStyle}"
                                Header="Input Setup">

                                <DockPanel>

                                    <uc:MVSInputSetup
                                        x:Name="ucMVSInputSetup" />

                                </DockPanel>

                            </TabItem>

                            <TabItem Style="{StaticResource SesNativeSubTabItemStyle}"
                                Header="MVS Output">

                                <DockPanel>

                                    <uc:MVSOutput
                                        x:Name="ucMVSOutput" />

                                </DockPanel>

                            </TabItem>

                        </TabControl>

                    </DockPanel>

                </TabItem>

                <!--==============================================================-->
                <!--Side Menu: Admin Settings-->
                <!--==============================================================-->
                <TabItem Style="{StaticResource SesNativeNavigationTabItemStyle}"
                    Name="tabAdminSettings"
                    Visibility="Collapsed"
                    Header="Admin">

                    <TabItem.HeaderTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Grid.Column="0"
                                    Width="18"
                                    HorizontalAlignment="Center"
                                    Source="../Icons/outline_admin_panel_settings_white_36dp.png" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding}"
                                    Foreground="{StaticResource SesWhiteBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding Source={x:Static uc:MenuStateVM.Instance}, Path=showMenuLabels, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </TabItem.HeaderTemplate>

                    <uc:AdminSettings
                        x:Name="ucAdminSettings" />

                </TabItem>

                <!--==============================================================-->
                <!--Side Menu: Messages-->
                <!--==============================================================-->
                <TabItem Style="{StaticResource SesNativeNavigationTabItemStyle}"
                    Name="tabErrorMessages"
                    Visibility="Collapsed"
                    Header="Messages">

                    <TabItem.HeaderTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Image
                                        Width="18"
                                        HorizontalAlignment="Center"
                                        Source="../Icons/outline_announcement_white_36dp.png" />
                                    <Ellipse
                                        Width="14"
                                        Height="14"
                                        Fill="Red"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-2,-2,0"
                                        Visibility="{Binding Source={x:Static uc:MenuStateVM.Instance}, Path=hasNewMessages, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding}"
                                    Foreground="{StaticResource SesWhiteBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding Source={x:Static uc:MenuStateVM.Instance}, Path=showMenuLabels, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </TabItem.HeaderTemplate>

                    <uc:ErrorMessagesPage
                        x:Name="ucErrorMessagesPage" />

                </TabItem>

            </TabControl>

        </DockPanel>

        <StackPanel
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom">

            <!--Screen Capture button-->            <Button
                x:Name="btnScreenCapture"
                HorizontalAlignment="Center"
                Background="Transparent"
                Width="80"
                Height="60"
                Click="btnScreenCapture_Click">

                <Button.Style>
                    <Style
                        TargetType="{x:Type Button}">

                        <Setter
                            Property="Template">
                            <Setter.Value>
                                <ControlTemplate
                                    TargetType="{x:Type Button}">
                                    <Border
                                        x:Name="Border"
                                        Background="{TemplateBinding Background}">
                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger
                                            Property="IsMouseOver"
                                            Value="True">
                                            <Setter
                                                Property="Background"
                                                Value="DimGray"
                                                TargetName="Border" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>

                <StackPanel>

                    <Image
                        Width="36"
                        Source="..\Icons\outline_photo_camera_white_48dp.png" />

                </StackPanel>

            </Button>

            <!--About button-->
            <Button
                x:Name="btnAbout"
                HorizontalAlignment="Center"
                Width="80"
                Height="60"
                Background="Transparent"
                Click="btnAbout_Click">

                <Button.Style>
                    <Style
                        TargetType="{x:Type Button}">

                        <Setter
                            Property="Template">
                            <Setter.Value>
                                <ControlTemplate
                                    TargetType="{x:Type Button}">
                                    <Border
                                        x:Name="Border"
                                        Background="{TemplateBinding Background}">
                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger
                                            Property="IsMouseOver"
                                            Value="True">
                                            <Setter
                                                Property="Background"
                                                Value="DimGray"
                                                TargetName="Border" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>

                <StackPanel>

                    <Image
                        Width="36"
                        Source="..\Icons\information-outline.png" />

                </StackPanel>

            </Button>

            <!--Collapse/expand menu labels button-->
            <Button
                x:Name="btnToggleMenuLabels"
                Margin="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="Transparent"
                BorderBrush="Transparent"
                ToolTip="Show/hide menu labels"
                Click="btnToggleMenuLabels_Click">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        x:Name="tbToggleMenuLabelsGlyph"
                        Text="&#xAB;"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>

            </Button>

        </StackPanel>


    </Grid>

</Window>