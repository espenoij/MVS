<UserControl
    x:Class="MVS.MVSInputSetup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="1100"
    d:DesignWidth="1900">

    <UserControl.Resources>
        <Style
            x:Key="SensorDataGridStatusColorCode"
            TargetType="{x:Type DataGridRow}"
            BasedOn="{StaticResource SesNativeDataGridRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=statusString}" Value="TIMEOUT_ERROR">
                    <Setter Property="Background" Value="{StaticResource ColorAmber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=statusString}" Value="OK">
                    <Setter Property="Background" Value="{StaticResource ColorGreen}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=statusString}" Value="OK_NA">
                    <Setter Property="Background" Value="{StaticResource ColorGreen}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=statusString}" Value="NONE">
                    <Setter Property="Background" Value="Transparent" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="1*" />
            <ColumnDefinition
                Width="1*" />
        </Grid.ColumnDefinitions>

        <GroupBox
            Style="{StaticResource SesNativeGroupBoxStyle}"
            Header="SENSOR DATA"
            Grid.Column="0"
            Margin="8">

            <DataGrid
                DockPanel.Dock="Left"
                Name="gvSensorInputData"
                Style="{StaticResource SesNativeDataGridStyle}"
                RowStyle="{StaticResource SensorDataGridStatusColorCode}"
                Margin="0,8,0,0"
                ItemsSource="{Binding SensorData}"
                IsReadOnly="True"
                IsManipulationEnabled="True"
                CanUserSortColumns="True"
                CanUserReorderColumns="False"
                CanUserDeleteRows="True"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                AutoGenerateColumns="False">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Width="110"
                        Header="Data ID"
                        Binding="{Binding id}" />
                    <DataGridTextColumn
                        Width="300"
                        Header="Name"
                        Binding="{Binding name}" />
                    <DataGridTextColumn
                        Width="160"
                        Header="Data"
                        Binding="{Binding data}" />

                </DataGrid.Columns>

            </DataGrid>

        </GroupBox>

        <GroupBox
            Style="{StaticResource SesNativeGroupBoxStyle}"
            Header="MVS INPUT"
            Grid.Column="1"
            Margin="8">

            <DataGrid
                DockPanel.Dock="Left"
                Name="gvHMSInputData"
                Margin="0,8,0,0"
                ItemsSource="{Binding SensorData}"
                Style="{StaticResource SesNativeDataGridStyle}"
                RowStyle="{StaticResource SensorDataGridStatusColorCode}"
                IsManipulationEnabled="True"
                CanUserSortColumns="True"
                CanUserReorderColumns="False"
                CanUserDeleteRows="False"
                CanUserAddRows="False"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                AutoGenerateColumns="False"
                BeginningEdit="gvClientData_BeginningEdit"
                CellEditEnding="gvClientData_CellEditEnding"
                RowEditEnding="gvClientData_RowEditEnding">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Width="300"
                        Header="Name"
                        IsReadOnly="True"
                        Binding="{Binding name}" />
                    <DataGridTextColumn
                        Width="120"
                        Header="Data ID"
                        Binding="{Binding dataId, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn
                        Width="160"
                        Header="Data"
                        IsReadOnly="True"
                        Binding="{Binding data}" />

                </DataGrid.Columns>

            </DataGrid>

        </GroupBox>

    </Grid>

</UserControl>
