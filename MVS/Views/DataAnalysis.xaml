                            Grid.ColumnSpan="2"
                            Content="-15"
                            HorizontalAlignment="Center" />

                        <Label
                            Grid.Column="3"
                            Grid.ColumnSpan="2"
                            Content="-10"
                            HorizontalAlignment="Center" />

                        <Label
                            Grid.Column="5"
                            Grid.ColumnSpan="2"
                            Content="-5"
                            HorizontalAlignment="Center" />

                        <Label
                            Grid.Column="10"
                            Content="0"
                            HorizontalAlignment="Right" />

