            Margin="8,8,8,0"
            Padding="12,6"
            Background="{StaticResource SesSurfaceAltBrush}"
            BorderBrush="{StaticResource SesBorderBrush}"
            BorderThickness="1"
            CornerRadius="3">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                <!-- Reference MRU -->
                <Rectangle
                    Width="28" Height="3"
                    Fill="{StaticResource ColorGraphLineRef}"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0" />
                <TextBlock
                    Text="Reference MRU"
                    VerticalAlignment="Center"
                    Margin="0,0,24,0" />

                <!-- Vessel MRU -->
                <Rectangle
                    Width="28" Height="3"
                    Fill="{StaticResource ColorGraphLineTest}"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0" />
                <TextBlock
                    Text="Vessel MRU"
                    VerticalAlignment="Center"
                    Margin="0,0,24,0" />

