<UserControl
    x:Class="MVS.DataAnalysis"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:MVS"
    xmlns:controls="clr-namespace:MVS.Views.Controls"
    mc:Ignorable="d"
    d:DesignHeight="1280"
    d:DesignWidth="1920">

    <UserControl.Resources>

        <sys:Double
            x:Key="ChartWidth">1600</sys:Double>
        <sys:Double
            x:Key="ChartHeight">200</sys:Double>

        <sys:Double
            x:Key="lineLegendWidth">2</sys:Double>
        <sys:Double
            x:Key="lineLegendWidthTitle">4</sys:Double>
        <sys:Double
            x:Key="lineLegendHeight">2</sys:Double>

        <local:LabelAbsConverter
            x:Key="LabelAbsConverter" />

        <!-- Match font appearances to the Projects.xaml page style -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SesFontFamily}"/>
            <Setter Property="Foreground" Value="{StaticResource SesTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="{StaticResource SesFontFamily}"/>
            <Setter Property="Foreground" Value="{StaticResource SesTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- legend -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--======================================================-->
        <!-- Legend bar — shared by all three axis chart groups    -->
        <!--======================================================-->
        <Border
            Grid.Row="0"
            Margin="8,8,8,0"
            Padding="12,6"
            Background="{StaticResource SesSurfaceAltBrush}"
            BorderBrush="{StaticResource SesBorderBrush}"
            BorderThickness="1"
            CornerRadius="3">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                <!-- Reference MRU -->
                <Rectangle
                    Width="28" Height="3"
                    Fill="{StaticResource ColorGraphLineRef}"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0" />
                <TextBlock
                    Text="Reference MRU"
                    VerticalAlignment="Center"
                    Margin="0,0,24,0" />

                <!-- Vessel MRU -->
                <Rectangle
                    Width="28" Height="3"
                    Fill="{StaticResource ColorGraphLineTest}"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0" />
                <TextBlock
                    Text="Vessel MRU"
                    VerticalAlignment="Center"
                    Margin="0,0,24,0" />

                <!-- Mean Deviation -->
                <Rectangle
                    Width="28" Height="3"
                    Fill="{StaticResource ColorGraphLineDev}"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0" />
                <TextBlock
                    Text="Mean Deviation"
                    VerticalAlignment="Center" />

            </StackPanel>
        </Border>

        <!--===========================================================-->
        <!--===========================================================-->
        <!--===========================================================-->
        <!--PITCH-->
        <!--===========================================================-->
        <!--===========================================================-->
        <!--===========================================================-->
