<Window
    x:Class="MVS.ModbusSetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:MVS"
    mc:Ignorable="d"
    Title="MODBUS Data Setup"
    WindowState="Maximized"
    Height="1010"
    Width="1300"
    Icon="pack://application:,,,/MVS;component/Icons/mvs_windows_icon.ico">

    <DockPanel>

        <!--Status Bar-->
        <StatusBar
            DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock
                    Name="sensorMonitorStatus" />
            </StatusBarItem>
        </StatusBar>

        <Grid
            DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="400" />
                <ColumnDefinition
                    Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0">

                <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                    Header="Basic Information"
                    Margin="8">

                    <StackPanel>

                        <DockPanel>
                            <Label
                                Width="110"
                                Content="ID" />
                            <Label
                                Name="lbSensorID" />
                        </DockPanel>

                        <DockPanel>
                            <Label
                                Width="110"
                                Content="Name"
                                VerticalAlignment="Center" />
                            <Label
                                Name="lbSensorName" />
                        </DockPanel>

                        <DockPanel>
                            <Label
                                Width="110"
                                Content="Type"
                                VerticalAlignment="Center" />
                            <Label
                                Name="lbSensorType" />
                        </DockPanel>


                    </StackPanel>

                </GroupBox>
                
                <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                    Header="Connection"
                    Margin="8">
                    
                    <StackPanel>

                        <DockPanel>
                            <Label
                                Width="110"
                                Content="COM Port"
                                VerticalAlignment="Center" />
                            <ComboBox
                                Width="auto"
                                Name="cboPortName"
                                SelectionChanged="cboCOMPort_SelectionChanged" />
                        </DockPanel>

                        <DockPanel>
                            <Label
                                Width="110"
                                Content="Baud Rate"
                                VerticalAlignment="Center" />
                            <ComboBox
                                Width="auto"
                                Name="cboBaudRate"
                                SelectionChanged="cboBaudRate_SelectionChanged">
                            </ComboBox>
                        </DockPanel>

                        <DockPanel>
                            <Label
                                Width="110"
                                Content="Data Bits"
                                VerticalAlignment="Center" />
                            <ComboBox
                                Width="auto"
                                Name="cboDataBits"
                                SelectionChanged="cboDataBits_SelectionChanged">
                            </ComboBox>
                        </DockPanel>

                        <DockPanel>
                            <Label
                                Width="110"
                                Content="Stop Bits"
                                VerticalAlignment="Center" />
                            <ComboBox
                                Width="auto"
                                Name="cboStopBits"
                                SelectionChanged="cboStopBits_SelectionChanged">
                            </ComboBox>
                        </DockPanel>

                        <DockPanel>
                            <Label
                                Width="110"
                                Content="Data Parity"
                                VerticalAlignment="Center" />
                            <ComboBox
                                Width="auto"
                                Name="cboParity"
                                SelectionChanged="cboDataParity_SelectionChanged">
                            </ComboBox>
                        </DockPanel>

                        <DockPanel>
                            <Label
                                Width="110"
                                Content="Hand Shake"
                                VerticalAlignment="Center" />
                            <ComboBox
                                Width="auto"
                                Name="cboHandShake"
                                SelectionChanged="cboHandShake_SelectionChanged">
                            </ComboBox>
                        </DockPanel>

                        <DockPanel>
                            <Label
                                Width="110"
                                Content="TCP Address"
                                VerticalAlignment="Center" />
                            <TextBox
                                Name="tbModbusTCPAddress"
                                LostFocus="tbModbusTCPAddress_LostFocus"
                                KeyDown="tbModbusTCPAddress_KeyDown"/>
                        </DockPanel>

                        <DockPanel>
                            <Label
                                Name="lbModbusTCPPort"
                                Width="110"
                                Content="TCP Port"
                                VerticalAlignment="Center" />
                            <TextBox
                                Name="tbModbusTCPPort"
                                LostFocus="tbModbusTCPPort_LostFocus" 
                                KeyDown="tbModbusTCPPort_KeyDown"/>
                        </DockPanel>

                        <DockPanel>
                            <Label
                                Width="110"
                                Content="Slave ID"
                                VerticalAlignment="Center" />
                            <TextBox
                                Name="tbModbusSlaveID"
                                LostFocus="tbModbusSlaveID_LostFocus" 
                                KeyDown="tbModbusSlaveID_KeyDown"/>
                        </DockPanel>

                    </StackPanel>
                    
                </GroupBox>

                <!--Data Range-->
                <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                    Header="Data Range"
                    Margin="8">

                    <StackPanel
                        DockPanel.Dock="Right"
                        Orientation="Vertical">

                        <DockPanel>
                            <Label
                                Width="140"
                                Content="Start Address"
                                VerticalAlignment="Center" />
                            <TextBox
                                Name="tbSampleDataStartAddress"
                                LostFocus="tbSampleDataRangeAddress_LostFocus"
                                KeyDown="tbSampleDataStartAddress_KeyDown"/>
                        </DockPanel>

                        <DockPanel>
                            <Label
                                Width="140"
                                Content="Total Addresses"
                                VerticalAlignment="Center" />
                            <TextBox
                                Name="tbSampleDataTotalAddresses"
                                LostFocus="tbDataRangeTotalAddresses_LostFocus" 
                                KeyDown="tbSampleDataTotalAddresses_KeyDown"/>
                        </DockPanel>

                    </StackPanel>

                </GroupBox>

                <!--Serial Port Controls-->
                <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                    Header="Connection Controls"
                    Margin="8">

                    <StackPanel>
                        
                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                            <Button
                                x:Name="btnModbusReaderStart"
                                Click="btnModbusReaderOpen_Click"
                                Width="120"
                                Margin="8"
                                Content="Open" />
                            <Button
                                x:Name="btnModbusReaderStop"
                                Click="btnModbusReaderClose_Click"
                                Width="120"
                                Margin="8"
                                IsEnabled="False"
                                Content="Close" />

                        </StackPanel>

                        <Rectangle
                            Width="auto"
                            Height="7"
                            Margin="8">
                            <Rectangle.Fill>
                                <VisualBrush
                                    Stretch="None">
                                    <VisualBrush.Visual>
                                        <Border
                                            x:Name="bModbusPortStatus"
                                            CornerRadius="3,3,3,3"
                                            Width="120"
                                            Height="7"
                                            Background="{StaticResource ColorRed}"
                                            BorderThickness="1"
                                            BorderBrush="Gray" />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                    </StackPanel>

                </GroupBox>


                <!--Serial Port Controls-->
                <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                    Header="Data Display"
                    Margin="8">

                    
                    <StackPanel>

                        <DockPanel>

                            <Label
                                Width="200"
                                Content="Data Lines"
                                VerticalAlignment="Center" />

                            <TextBox
                                Name="tbDataLines"
                                Text="{Binding totalDataLinesString}"
                                LostFocus="tbDataLines_LostFocus"
                                KeyDown="tbDataLines_KeyDown" />

                        </DockPanel>

                        <Button
                            Name="chkSelectedDataClear"
                            Click="chkSelectedDataClear_Click"
                            Width="90"
                            HorizontalAlignment="Left">Clear</Button>

                    </StackPanel>

                </GroupBox>
                
            </StackPanel>

            <TabControl
                Grid.Row="0"
                Grid.Column="1"
                Margin="8">

                <!--1. Packet Selection-->
                <TabItem
                    Name="tabPacketSelection"
                    Header="1: Data Selection">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="400" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="*" />
                            <RowDefinition
                                Height="*" />
                        </Grid.RowDefinitions>

                        <!--Sample Data-->
                        <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                            Grid.Row="0"
                            Grid.Column="0"
                            Header="Raw Data"
                            Margin="8">

                            <DataGrid
                                Name="lvModbusRawData"
                                Style="{StaticResource SesNativeDataGridStyle}"
                                IsReadOnly="True"
                                IsManipulationEnabled="False"
                                CanUserSortColumns="False"
                                HeadersVisibility="Column"
                                RowHeight="25"
                                ColumnWidth="200"
                                Margin="8"
                                CanUserReorderColumns="False"
                                CanUserDeleteRows="False"
                                SelectionUnit="FullRow"
                                AutoGenerateColumns="False">

                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Header="Address"
                                        Width="120"
                                        Binding="{Binding addressString}" />
                                    <DataGridTextColumn
                                        Header="Data"
                                        Width="*"
                                        Binding="{Binding dataString}" />
                                </DataGrid.Columns>

                            </DataGrid>

                        </GroupBox>

                        <DockPanel
                            Grid.Column="1"
                            Grid.Row="0">
                            
                            <!--Data Selection-->
                            <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                                Header="Data Selection"
                                Margin="8">

                                <StackPanel
                                    Margin="8">
                                    
                                    <DockPanel>
                                        <Label
                                            Width="120"
                                            Content="Address"
                                            VerticalAlignment="Center" />
                                        <TextBox
                                            Name="tbSelectDataAddress"
                                            LostFocus="tbSelectDataAddress_LostFocus"
                                            KeyDown="tbSelectDataAddress_KeyDown"/>
                                    </DockPanel>

                                </StackPanel>

                            </GroupBox>

                        </DockPanel>

                        <!--Selected Data-->
                        <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                            Grid.Row="1"
                            Grid.Column="0"
                            Header="Selected Data"
                            Margin="8">

                            <DockPanel>

                                <DataGrid
                                    DockPanel.Dock="Left"
                                    Name="lvSelectedData"
                                    Style="{StaticResource SesNativeDataGridStyle}"
                                    IsReadOnly="True"
                                    IsManipulationEnabled="False"
                                    CanUserSortColumns="False"
                                    HeadersVisibility="None"
                                    RowHeight="25"
                                    Margin="8"
                                    CanUserReorderColumns="False"
                                    CanUserDeleteRows="False"
                                    SelectionUnit="FullRow"
                                    AutoGenerateColumns="False">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Binding="{Binding dataString}" />
                                    </DataGrid.Columns>

                                </DataGrid>

                            </DockPanel>

                        </GroupBox>

                    </Grid>

                </TabItem>

                <!--1. Packet Selection-->
                <TabItem
                    Name="tabDataCalculations"
                    Header="2: Data Calculations">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="360" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="*" />
                            <RowDefinition
                                Height="*" />
                        </Grid.RowDefinitions>

                        <!--Selected Data-->
                        <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                            Grid.Row="0"
                            Grid.Column="0"
                            Header="Selected Data"
                            Margin="8">

                            <DockPanel>

                                <DataGrid
                                    DockPanel.Dock="Left"
                                    Name="lvSelectedData2"
                                    Style="{StaticResource SesNativeDataGridStyle}"
                                    IsReadOnly="True"
                                    IsManipulationEnabled="False"
                                    CanUserSortColumns="False"
                                    HeadersVisibility="None"
                                    RowHeight="25"
                                    Margin="8"
                                    CanUserReorderColumns="False"
                                    CanUserDeleteRows="False"
                                    SelectionUnit="FullRow"
                                    AutoGenerateColumns="False">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Binding="{Binding dataString}" />
                                    </DataGrid.Columns>

                                </DataGrid>

                            </DockPanel>

                        </GroupBox>

                        <StackPanel
                            Grid.Column="1"
                            Grid.Row="0"
                            Grid.RowSpan="2">

                            <!--Data Calculation 1-->
                            <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                                Header="Data Calculation 1"
                                Margin="8">

                                <StackPanel
                                    Margin="8">

                                    <DockPanel>
                                        <Label
                                            Width="80"
                                            Content="Type"
                                            VerticalAlignment="Center" />
                                        <ComboBox
                                            Width="auto"
                                            Name="cboCalculationType1"
                                            MaxDropDownHeight="400"
                                            SelectionChanged="cboCalculationType1_SelectionChanged">
                                        </ComboBox>
                                    </DockPanel>

                                    <DockPanel>
                                        <Label
                                            Width="120"
                                            Content="Parameter"
                                            VerticalAlignment="Center" />
                                        <TextBox
                                            Name="tbCalculationParameter1"
                                            LostFocus="tbCalculationParameter1_LostFocus"
                                            KeyDown="tbCalculationParameter1_KeyDown"/>
                                    </DockPanel>

                                </StackPanel>

                            </GroupBox>


                            <!--Data Calculation 2-->
                            <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                                Header="Data Calculation 2"
                                Margin="8">

                                <StackPanel
                                    Margin="8">

                                    <DockPanel>
                                        <Label
                                            Width="80"
                                            Content="Type"
                                            VerticalAlignment="Center" />
                                        <ComboBox
                                            Width="auto"
                                            Name="cboCalculationType2"
                                            MaxDropDownHeight="400"
                                            SelectionChanged="cboCalculationType2_SelectionChanged">
                                        </ComboBox>
                                    </DockPanel>

                                    <DockPanel>
                                        <Label
                                            Width="120"
                                            Content="Parameter"
                                            VerticalAlignment="Center" />
                                        <TextBox
                                            Name="tbCalculationParameter2"
                                            LostFocus="tbCalculationParameter2_LostFocus"
                                            KeyDown="tbCalculationParameter2_KeyDown"/>
                                    </DockPanel>

                                </StackPanel>

                            </GroupBox>


                            <!--Data Calculation 3-->
                            <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                                Header="Data Calculation 3"
                                Margin="8">

                                <StackPanel
                                    Margin="8">

                                    <DockPanel>
                                        <Label
                                            Width="80"
                                            Content="Type"
                                            VerticalAlignment="Center" />
                                        <ComboBox
                                            Width="auto"
                                            Name="cboCalculationType3"
                                            MaxDropDownHeight="400"
                                            SelectionChanged="cboCalculationType3_SelectionChanged">
                                        </ComboBox>
                                    </DockPanel>

                                    <DockPanel>
                                        <Label
                                            Width="120"
                                            Content="Parameter"
                                            VerticalAlignment="Center" />
                                        <TextBox
                                            Name="tbCalculationParameter3"
                                            LostFocus="tbCalculationParameter3_LostFocus"
                                            KeyDown="tbCalculationParameter3_KeyDown"/>
                                    </DockPanel>

                                </StackPanel>

                            </GroupBox>

                            <!--Data Calculation 3-->
                            <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                                Header="Data Calculation 4"
                                Margin="8">

                                <StackPanel
                                    Margin="8">

                                    <DockPanel>
                                        <Label
                                            Width="80"
                                            Content="Type"
                                            VerticalAlignment="Center" />
                                        <ComboBox
                                            Width="auto"
                                            Name="cboCalculationType4"
                                            MaxDropDownHeight="400"
                                            SelectionChanged="cboCalculationType4_SelectionChanged">
                                        </ComboBox>
                                    </DockPanel>

                                    <DockPanel>
                                        <Label
                                            Width="120"
                                            Content="Parameter"
                                            VerticalAlignment="Center" />
                                        <TextBox
                                            Name="tbCalculationParameter4"
                                            LostFocus="tbCalculationParameter4_LostFocus"
                                            KeyDown="tbCalculationParameter4_KeyDown"/>
                                    </DockPanel>

                                </StackPanel>

                            </GroupBox>

                        </StackPanel>

                        <!--Processed Data-->
                        <GroupBox Style="{StaticResource SesNativeGroupBoxStyle}"
                            Grid.Column="0"
                            Grid.Row="1"
                            Header="Calculated Data"
                            Margin="8">

                            <DockPanel>

                                <DataGrid
                                    DockPanel.Dock="Left"
                                    Name="lvCalculatedData"
                                    Style="{StaticResource SesNativeDataGridStyle}"
                                    IsReadOnly="True"
                                    IsManipulationEnabled="False"
                                    CanUserSortColumns="False"
                                    HeadersVisibility="None"
                                    RowHeight="25"
                                    Margin="8"
                                    CanUserReorderColumns="False"
                                    CanUserDeleteRows="False"
                                    SelectionUnit="FullRow"
                                    AutoGenerateColumns="False">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Binding="{Binding calculatedDataString}" />
                                    </DataGrid.Columns>

                                </DataGrid>

                            </DockPanel>

                        </GroupBox>

                    </Grid>

                </TabItem>
                
            </TabControl>

        </Grid>

    </DockPanel>

</Window>
