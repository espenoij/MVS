<UserControl
    x:Class="MVS.CaptureCharts"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="clr-namespace:MVS.Views.Controls"
    mc:Ignorable="d"
    d:DesignHeight="700"
    d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="12,6"
            Background="{StaticResource SesSurfaceAltBrush}"
            BorderBrush="{StaticResource SesBorderBrush}"
            BorderThickness="1"
            CornerRadius="3">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Rectangle Width="28" Height="3"
                               Fill="{StaticResource ColorGraphLineRef}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBlock Text="Reference MRU"
                               VerticalAlignment="Center"
                               Margin="0,0,24,0" />
                    <Rectangle Width="28" Height="3"
                               Fill="{StaticResource ColorGraphLineTest}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBlock Text="Vessel MRU"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="12,4" CornerRadius="4"
                        Background="{StaticResource SesErrorBrush}"
                        Visibility="{Binding MainWindowVM.IsRecording, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource SesWhiteBrush}" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1.0" To="0.3" Duration="0:0:0.6"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="RECORDING" FontSize="12" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Pitch Input" HorizontalAlignment="Center" />
            <controls:LiveLineChart
                x:Name="chartPitch"
                Grid.Row="1"
                MinHeight="180"
                Margin="10,0,0,0"
                TimeMinimum="{Binding alignmentTimeMin}"
                TimeMaximum="{Binding alignmentTimeMax}"
                Minimum="{Binding pitchChartAxisMin}"
                Maximum="{Binding pitchChartAxisMax}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Roll Input" HorizontalAlignment="Center" />
            <controls:LiveLineChart
                x:Name="chartRoll"
                Grid.Row="1"
                MinHeight="180"
                Margin="10,0,0,0"
                TimeMinimum="{Binding alignmentTimeMin}"
                TimeMaximum="{Binding alignmentTimeMax}"
                Minimum="{Binding rollChartAxisMin}"
                Maximum="{Binding rollChartAxisMax}" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Heave Input" HorizontalAlignment="Center" />
            <controls:LiveLineChart
                x:Name="chartHeave"
                Grid.Row="1"
                MinHeight="180"
                Margin="10,0,0,0"
                TimeMinimum="{Binding alignmentTimeMin}"
                TimeMaximum="{Binding alignmentTimeMax}"
                Minimum="{Binding heaveChartAxisMin}"
                Maximum="{Binding heaveChartAxisMax}" />
        </Grid>
    </Grid>
</UserControl>
