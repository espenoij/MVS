<UserControl x:Class="MVS.Views.Controls.VerificationResultCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignWidth="380" d:DesignHeight="320">

	<Grid
		Margin="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Header: axis title + acceptance status badge -->
		<Grid Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="tbAxisTitle"
					   Text="Axis"
					   FontFamily="{StaticResource SesFontFamily}"
					   FontSize="16"
					   FontWeight="Bold"
					   Foreground="{StaticResource SesTextPrimaryBrush}"/>
			<TextBlock x:Name="tbAxisUnit"
					   Grid.Column="1"
					   Text=""
					   Foreground="{StaticResource SesTextSecondaryBrush}"
					   VerticalAlignment="Bottom"
					   Margin="6,0,0,2"/>
			<Border x:Name="statusBadge"
					Grid.Column="3"
					CornerRadius="10"
					Padding="10,2"
					VerticalAlignment="Center"
					HorizontalAlignment="Right"
					Background="{StaticResource SesSurfaceAltBrush}">
				<TextBlock x:Name="tbStatusLabel"
						   Text="No data"
						   FontSize="11"
						   FontWeight="SemiBold"
						   Foreground="{StaticResource SesTextSecondaryBrush}"/>
			</Border>
		</Grid>

		<Rectangle Grid.Row="1" Height="1" Fill="{StaticResource SesBorderBrush}" Margin="0,8"/>

		<!-- Reference / Vessel / Analysis / Correction table -->
		<Grid Grid.Row="2" Margin="0,4,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="24"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- Header row -->
			<TextBlock Grid.Row="0" Grid.Column="1" Text="Mean" FontWeight="SemiBold" Foreground="{StaticResource SesTextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,4"/>
			<TextBlock Grid.Row="0" Grid.Column="3" Text="Min" FontWeight="SemiBold" Foreground="{StaticResource SesTextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,16,4"/>
			<TextBlock Grid.Row="0" Grid.Column="4" Text="Max" FontWeight="SemiBold" Foreground="{StaticResource SesTextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,16,4"/>
			<TextBlock Grid.Row="0" Grid.Column="5" Text="Std Dev" FontWeight="SemiBold" Foreground="{StaticResource SesTextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,16,4"/>
			<TextBlock Grid.Row="0" Grid.Column="6" Text="RMS" FontWeight="SemiBold" Foreground="{StaticResource SesTextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,4"/>

			<!-- Reference -->
			<TextBlock Grid.Row="1" Grid.Column="0" Text="Reference MRU" FontWeight="SemiBold" Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,8"/>
			<TextBlock Grid.Row="1" Grid.Column="1" x:Name="tbRefMean" Text="—" FontSize="14" Foreground="{StaticResource SesTextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,8"/>
			<TextBlock Grid.Row="1" Grid.Column="3" x:Name="tbRefMin" Text="—" FontSize="14" Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,8"/>
			<TextBlock Grid.Row="1" Grid.Column="4" x:Name="tbRefMax" Text="—" FontSize="14" Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,8"/>
			<TextBlock Grid.Row="1" Grid.Column="5" x:Name="tbRefStdDev" Text="—" FontSize="14" Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,8"/>
			<TextBlock Grid.Row="1" Grid.Column="6" x:Name="tbRefRms" Text="—" FontSize="14" Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,8"/>

			<!-- Vessel MRU -->
			<TextBlock Grid.Row="2" Grid.Column="0" Text="Vessel MRU" FontWeight="SemiBold" Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,16"/>
			<TextBlock Grid.Row="2" Grid.Column="1" x:Name="tbTestMean" Text="—" FontSize="14" Foreground="{StaticResource SesTextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,16"/>
			<TextBlock Grid.Row="2" Grid.Column="3" x:Name="tbTestMin" Text="—" FontSize="14" Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,16"/>
			<TextBlock Grid.Row="2" Grid.Column="4" x:Name="tbTestMax" Text="—" FontSize="14" Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,16"/>
			<TextBlock Grid.Row="2" Grid.Column="5" x:Name="tbTestStdDev" Text="—" FontSize="14" Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,16"/>
			<TextBlock Grid.Row="2" Grid.Column="6" x:Name="tbTestRms" Text="—" FontSize="14" Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,16"/>

			<!-- Analysis header labels -->
			<TextBlock Grid.Row="3" Grid.Column="1" Text="Deviation" FontWeight="SemiBold" Foreground="{StaticResource SesTextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,4"/>
			<TextBlock Grid.Row="3" Grid.Column="3" Text="Samples" FontWeight="SemiBold" Foreground="{StaticResource SesTextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,16,4"/>
			<TextBlock Grid.Row="3" Grid.Column="4" Text="Outliers" FontWeight="SemiBold" Foreground="{StaticResource SesTextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,16,4"/>
			<TextBlock Grid.Row="3" Grid.Column="5" Text="Std Dev" FontWeight="SemiBold" Foreground="{StaticResource SesTextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,16,4"/>

			<!-- Analysis values -->
			<TextBlock Grid.Row="4" Grid.Column="0" Text="Analysis" FontWeight="SemiBold" Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
			<TextBlock Grid.Row="4" Grid.Column="1" x:Name="tbDevMean" Text="—" FontSize="14" Foreground="{StaticResource SesInfoBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,0"/>
			<TextBlock Grid.Row="4" Grid.Column="3" x:Name="tbDevSamples" Text="—" FontSize="14" Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
			<TextBlock Grid.Row="4" Grid.Column="4" x:Name="tbDevOutliers" Text="—" FontSize="14" Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
			<TextBlock Grid.Row="4" Grid.Column="5" x:Name="tbDevStdDev" Text="—" FontSize="14" Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>

			<!-- Correction: label in col 0, value in col 1 aligned with means above -->
			<TextBlock Grid.Row="5" Grid.Column="0" Text="Correction" FontWeight="SemiBold" Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,8,16,0"/>
			<TextBlock Grid.Row="5" Grid.Column="1" x:Name="tbCorrection" Text="—" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SesEnergyGreenTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,8,0,0"/>
		</Grid>

		<!-- Magnitude bar for deviation -->
		<telerik:RadProgressBar Grid.Row="3"
								x:Name="pbDeviationMagnitude"
								Height="4"
								Minimum="0" Maximum="100"
								Value="0"
								Margin="0,8,0,0"/>

		<!-- Plain-language assessment + glossary -->
		<Border Grid.Row="4"
				x:Name="assessmentPanel"
				CornerRadius="{StaticResource SesCornerRadius}"
				BorderThickness="1"
				Background="{StaticResource SesSurfaceAltBrush}"
				BorderBrush="{StaticResource SesBorderBrush}"
				Padding="8,6"
				Margin="0,8,0,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock x:Name="tbAssessment"
						   Text="Not enough captured data to assess this axis yet."
						   TextWrapping="Wrap"
						   FontSize="11"
						   Foreground="{StaticResource SesTextSecondaryBrush}"
						   VerticalAlignment="Center"/>
				<telerik:RadButton x:Name="btnInfo"
								   Grid.Column="1"
								   Content="?"
								   Width="24"
								   Height="24"
								   Margin="8,0,0,0"
								   VerticalAlignment="Top"
								   FontWeight="Bold"
								   FontSize="14"
								   Foreground="{StaticResource SesTextSecondaryBrush}"
								   Background="{StaticResource SesSurfaceAltBrush}"
								   BorderBrush="{StaticResource SesBorderBrush}"
								   BorderThickness="1"
								   Padding="0"
								   ToolTip="What do these numbers mean?"/>
			</Grid>
		</Border>


	</Grid>
</UserControl>
