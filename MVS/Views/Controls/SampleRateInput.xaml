<UserControl x:Class="MVS.Views.Controls.SampleRateInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="28" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="Input" MinHeight="32" Padding="4,2"
                 VerticalContentAlignment="Center"
                 FontFamily="{DynamicResource SesFontFamily}"
                 Foreground="{DynamicResource SesTextPrimaryBrush}"
                 AutomationProperties.Name="Sample rate in hertz"
                 TextChanged="Input_TextChanged"
                 LostKeyboardFocus="Input_LostKeyboardFocus"
                 PreviewKeyDown="Input_PreviewKeyDown" />
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <RepeatButton x:Name="Increase" Content="&#x25B2;" FontSize="8"
                          Focusable="False" AutomationProperties.Name="Increase sample rate"
                          Click="Increase_Click" />
            <RepeatButton x:Name="Decrease" Grid.Row="1" Content="&#x25BC;" FontSize="8"
                          Focusable="False" AutomationProperties.Name="Decrease sample rate"
                          Click="Decrease_Click" />
        </Grid>
    </Grid>
</UserControl>
