<UserControl x:Class="MVS.Views.Controls.ReportMetadataEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             d:DesignWidth="360">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontFamily" Value="{StaticResource SesFontFamily}"/>
            <Setter Property="Foreground" Value="{StaticResource SesTextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,8,0"/>
        </Style>
        <Style TargetType="telerik:RadWatermarkTextBox" x:Key="FieldBox" BasedOn="{StaticResource RadWatermarkTextBoxStyle}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="WatermarkContent" Value="Optional"/>
        </Style>
        <Style TargetType="telerik:RadWatermarkTextBox" x:Key="RequiredFieldBox" BasedOn="{StaticResource FieldBox}">
            <Setter Property="WatermarkContent" Value="Mandatory"/>
        </Style>
        <Style TargetType="telerik:RadWatermarkTextBox" x:Key="MultiLineFieldBox" BasedOn="{StaticResource FieldBox}">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>
        <Style TargetType="telerik:RadWatermarkTextBox" x:Key="RequiredMultiLineFieldBox" BasedOn="{StaticResource RequiredFieldBox}">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Section 2: Scope and objective -->
        <telerik:GroupBox Header="Scope &amp; Objective" Margin="0,0,0,10">
            <StackPanel Margin="8">
                <TextBlock Text="Test objective" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding TestObjective, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="48"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
                <TextBlock Text="Applicable standards" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding ApplicableStandards, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="40"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
            </StackPanel>
        </telerik:GroupBox>

        <!-- Section 3: Equipment - MRU under test -->
        <telerik:GroupBox Header="Equipment &#x2014; MRU Under Test (Vessel)" Margin="0,0,0,10">
            <StackPanel Margin="8">
                <TextBlock Text="Manufacturer" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding DutManufacturer, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
                <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding DutModel, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
                <TextBlock Text="Serial number" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding DutSerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
            </StackPanel>
        </telerik:GroupBox>

        <!-- Section 3: Equipment - Reference MRU -->
        <telerik:GroupBox Header="Equipment &#x2014; Reference MRU" Margin="0,0,0,10">
            <StackPanel Margin="8">
                <TextBlock Text="Manufacturer" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding ReferenceManufacturer, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
                <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding ReferenceModel, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
            </StackPanel>
        </telerik:GroupBox>

        <telerik:GroupBox Header="Equipment &#x2014; LiDAR" Margin="0,0,0,10">
            <StackPanel Margin="8">
                <TextBlock Text="Manufacturer" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding LidarManufacturer, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
                <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding LidarModel, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
            </StackPanel>
        </telerik:GroupBox>

        <telerik:GroupBox Header="Additional Equipment" Margin="0,0,0,10">
            <StackPanel Margin="8">
                <TextBlock Text="Additional equipment" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding AdditionalEquipment, UpdateSourceTrigger=LostFocus}"
                                             MinHeight="40"
                                             Style="{StaticResource MultiLineFieldBox}" LostFocus="Field_LostFocus"/>
            </StackPanel>
        </telerik:GroupBox>

        <!-- Section 4: Test setup -->
        <telerik:GroupBox Header="Test Setup" Margin="0,0,0,10">
            <StackPanel Margin="8">
                <TextBlock Text="Vessel MRU installation location" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding DutInstallationLocation, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
                <TextBlock Text="Reference MRU installation location" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding ReferenceInstallationLocation, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
                <TextBlock Text="Mounting arrangement" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding MountingArrangement, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="40"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
                <TextBlock Text="Coordinate system" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding CoordinateSystem, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
                <TextBlock Text="Sensor separation" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding SensorSeparation, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
                <TextBlock Text="Data acquisition method" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding DataAcquisitionMethod, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
                <TextBlock Text="Synchronization method" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding SynchronizationMethod, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
                <TextBlock Text="Sample rate (Hz)" Style="{StaticResource FieldLabel}"/>
                <telerik:RadNumericUpDown Value="{Binding SampleRateHz, UpdateSourceTrigger=PropertyChanged}"
                                          Minimum="0" Maximum="10000" IsInteger="False"
                                          Margin="0,4,0,0" LostFocus="Field_LostFocus"
                                          ValueChanged="RequiredField_ValueChanged"/>
                <TextBlock Text="Logging configuration" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding LoggingConfiguration, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="32"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
            </StackPanel>
        </telerik:GroupBox>

        <!-- Section 5: Test conditions -->
        <telerik:GroupBox Header="Test Conditions" Margin="0,0,0,10">
            <StackPanel Margin="8">
                <TextBlock Text="Loading condition" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding LoadingCondition, UpdateSourceTrigger=LostFocus}"
                                             MinHeight="32"
                                             Style="{StaticResource MultiLineFieldBox}" LostFocus="Field_LostFocus"/>
                <TextBlock Text="Vessel speed" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding VesselSpeed, UpdateSourceTrigger=LostFocus}"
                                             MinHeight="32"
                                             Style="{StaticResource MultiLineFieldBox}" LostFocus="Field_LostFocus"/>
                <TextBlock Text="Operational mode" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding OperationalMode, UpdateSourceTrigger=LostFocus}"
                                             MinHeight="32"
                                             Style="{StaticResource MultiLineFieldBox}" LostFocus="Field_LostFocus"/>
                <TextBlock Text="Sea state" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding SeaState, UpdateSourceTrigger=LostFocus}"
                                             MinHeight="32"
                                             Style="{StaticResource MultiLineFieldBox}" LostFocus="Field_LostFocus"/>
                <TextBlock Text="Wind conditions" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding WindConditions, UpdateSourceTrigger=LostFocus}"
                                             MinHeight="32"
                                             Style="{StaticResource MultiLineFieldBox}" LostFocus="Field_LostFocus"/>
                <TextBlock Text="Wave conditions" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding WaveConditions, UpdateSourceTrigger=LostFocus}"
                                             MinHeight="32"
                                             Style="{StaticResource MultiLineFieldBox}" LostFocus="Field_LostFocus"/>
                <TextBlock Text="Current conditions" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding CurrentConditions, UpdateSourceTrigger=LostFocus}"
                                             MinHeight="32"
                                             Style="{StaticResource MultiLineFieldBox}" LostFocus="Field_LostFocus"/>
                <TextBlock Text="Environmental notes" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding EnvironmentalNotes, UpdateSourceTrigger=LostFocus}"
                                             MinHeight="40"
                                             Style="{StaticResource MultiLineFieldBox}" LostFocus="Field_LostFocus"/>
            </StackPanel>
        </telerik:GroupBox>

        <!-- Section 6: Data processing methodology -->
        <telerik:GroupBox Header="Data Processing Notes" Margin="0,0,10,10">
            <StackPanel Margin="8">
                <TextBlock Text="Time synchronization notes" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding TimeSynchronizationNotes, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="40"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
                <TextBlock Text="Filtering notes" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding FilteringNotes, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="40"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
                <TextBlock Text="Data processing notes" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding DataProcessingNotes, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="40"
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
            </StackPanel>
        </telerik:GroupBox>

        <!-- Column 3: Criteria, Observations & Appendices -->

        <!-- Section 11: Acceptance criteria -->
        <telerik:GroupBox Header="Acceptance Criteria" Margin="0,0,0,10">
            <StackPanel Margin="8">

                <!-- Read-only compliance table: thresholds vs measured value and status -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header row -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Criterion"
                               Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Acceptable"
                               Style="{StaticResource FieldLabel}" FontWeight="SemiBold" TextAlignment="Right" Margin="10,0,0,0"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Good"
                               Style="{StaticResource FieldLabel}" FontWeight="SemiBold" TextAlignment="Right" Margin="10,0,0,0"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Measured"
                               Style="{StaticResource FieldLabel}" FontWeight="SemiBold" TextAlignment="Right" Margin="10,0,0,0"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Status"
                               Style="{StaticResource FieldLabel}" FontWeight="SemiBold" TextAlignment="Right" Margin="10,0,0,0"/>

                    <!-- Samples -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Samples"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="&#x2265; 300"
                               Style="{StaticResource FieldLabel}" TextAlignment="Right" Margin="10,0,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="&#x2265; 1&#x202F;500"
                               Style="{StaticResource FieldLabel}" TextAlignment="Right" Margin="10,0,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" TextAlignment="Right" Margin="10,0,0,0"
                               Style="{StaticResource FieldLabel}"
                               Text="{Binding ActualSampleCountText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <TextBlock Grid.Row="1" Grid.Column="4" TextAlignment="Right" Margin="10,0,0,0"
                               Style="{StaticResource FieldLabel}"
                               Text="{Binding SampleStatusText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                    <!-- Duration -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Capture duration"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="&#x2265; 20 min"
                               Style="{StaticResource FieldLabel}" TextAlignment="Right" Margin="10,0,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="&#x2265; 40 min"
                               Style="{StaticResource FieldLabel}" TextAlignment="Right" Margin="10,0,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" TextAlignment="Right" Margin="10,0,0,0"
                               Style="{StaticResource FieldLabel}"
                               Text="{Binding ActualDurationText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <TextBlock Grid.Row="2" Grid.Column="4" TextAlignment="Right" Margin="10,0,0,0"
                               Style="{StaticResource FieldLabel}"
                               Text="{Binding DurationStatusText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                    <!-- Outlier -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Max outlier"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="&#x2264; 15 %"
                               Style="{StaticResource FieldLabel}" TextAlignment="Right" Margin="10,0,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="&#x2264; 5 %"
                               Style="{StaticResource FieldLabel}" TextAlignment="Right" Margin="10,0,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="3" TextAlignment="Right" Margin="10,0,0,0"
                               Style="{StaticResource FieldLabel}"
                               Text="{Binding ActualWorstOutlierText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <TextBlock Grid.Row="3" Grid.Column="4" TextAlignment="Right" Margin="10,0,0,0"
                               Style="{StaticResource FieldLabel}"
                               Text="{Binding OutlierStatusText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Grid>

                <!-- Business-language assessment -->
                <TextBlock Text="Assessment" Style="{StaticResource FieldLabel}" Margin="0,10,8,0"/>
                <telerik:RadWatermarkTextBox x:Name="txtAssessment"
                                             Text="{Binding AcceptanceCriteriaDiscussion, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="64"
                                             WatermarkContent="Describe the data quality and overall assessment in plain language."
                                             Style="{StaticResource RequiredMultiLineFieldBox}" LostFocus="Field_LostFocus"
                                             TextChanged="RequiredField_TextChanged"/>
            </StackPanel>
        </telerik:GroupBox>

        <!-- Section 11: Observations -->
        <telerik:GroupBox Header="Observations" Margin="0,0,0,10">
            <StackPanel Margin="8">
                <TextBlock Text="Observations" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding Observations, UpdateSourceTrigger=LostFocus}"
                                             MinHeight="60"
                                             Style="{StaticResource MultiLineFieldBox}" LostFocus="Field_LostFocus"/>
            </StackPanel>
        </telerik:GroupBox>

        <!-- Section 12: Appendices -->
        <telerik:GroupBox Header="Appendices" Margin="0,0,0,10">
            <StackPanel Margin="8">
                <TextBlock Text="Appendix notes" Style="{StaticResource FieldLabel}"/>
                <telerik:RadWatermarkTextBox Text="{Binding AppendixNotes, UpdateSourceTrigger=LostFocus}"
                                             MinHeight="60"
                                             Style="{StaticResource MultiLineFieldBox}" LostFocus="Field_LostFocus"/>
            </StackPanel>
        </telerik:GroupBox>
    </StackPanel>
</UserControl>
