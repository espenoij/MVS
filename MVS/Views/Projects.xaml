<UserControl
    x:Class="MVS.Projects"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:controls="clr-namespace:MVS.Views.Controls"
    xmlns:local="clr-namespace:MVS"
    mc:Ignorable="d"
    d:DesignHeight="1100"
    d:DesignWidth="1400">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Status indicator color for the project list "Status" column. -->
        <Style x:Key="ProjectStatusColor" TargetType="Ellipse">
            <Style.Triggers>
                <DataTrigger Binding="{Binding projectStatus}" Value="OFF">
                    <Setter Property="Fill" Value="{StaticResource ColorBackgroundSeparator}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding projectStatus}" Value="GREEN">
                    <Setter Property="Fill" Value="{StaticResource ColorGreen}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding projectStatus}" Value="AMBER">
                    <Setter Property="Fill" Value="{StaticResource ColorAmber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding projectStatus}" Value="RED">
                    <Setter Property="Fill" Value="{StaticResource ColorRed}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

        <!-- Bridge element: DataContext is set to MainWindowVM in code-behind so Step 2 buttons can bind to it. -->
        <FrameworkElement x:Name="mainWindowVMBridge" Visibility="Collapsed"/>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Motion Unit Verification"
                                   FontFamily="{StaticResource SesFontFamily}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource SesTextPrimaryBrush}"/>
                        <TextBlock Text=" — Guided workflow"
                                   FontSize="14"
                                   Foreground="{StaticResource SesTextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="6,2,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="tbWizardProjectName"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SesEnergyGreenTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>

                <!-- Step indicator -->
                <telerik:RadStepProgressBar x:Name="wizardStepBar"
                                            Grid.Row="1"
                                            Margin="0,0,0,8"
                                            StepClicked="WizardStepBar_StepClicked">
                    <telerik:RadStepProgressBarItem Content="Setup"/>
                    <telerik:RadStepProgressBarItem Content="LiDAR"/>
                    <telerik:RadStepProgressBarItem Content="Capture"/>
                    <telerik:RadStepProgressBarItem Content="Review"/>
                    <telerik:RadStepProgressBarItem Content="Report"/>
                </telerik:RadStepProgressBar>

                <!-- Body: requirements banner + the four step panels stacked, only one visible at a time -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Requirements banner: tells the user what is needed before they can proceed -->
                    <Border Grid.Row="0"
                            x:Name="requirementsBanner"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,6"
                            Margin="0,0,0,8"
                            Visibility="Collapsed">
                        <TextBlock x:Name="tbRequirements"
                                   TextWrapping="Wrap"
                                   FontSize="12"/>
                    </Border>

                    <!-- Step panels -->
                    <Grid Grid.Row="1">

                    <!-- ===== STEP 1: SETUP ===== -->
                    <Grid x:Name="panelStep1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="350"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Projects list (left half of Step 1) -->
                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Projects"
                                       FontSize="14" FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,8">
                                <telerik:RadButton Name="btnNew"
                                                   Click="btnNew_Click"
                                                   Content="New"
                                                   MinWidth="100"/>
                                <telerik:RadButton Name="btnDelete"
                                                   Click="btnDelete_Click"
                                                   Content="Delete"
                                                   MinWidth="100"
                                                   Margin="8,0,0,0"/>
                            </StackPanel>

                            <telerik:RadGridView Grid.Row="2"
                                                 Name="gvProjects"
                                                 ItemsSource="{Binding Project}"
                                                 IsReadOnly="True"
                                                 IsManipulationEnabled="True"
                                                 CanUserSortColumns="True"
                                                 ShowGroupPanel="False"
                                                 CanUserReorderColumns="False"
                                                 CanUserDeleteRows="True"
                                                 RowIndicatorVisibility="Collapsed"
                                                 SelectionMode="Single"
                                                 AutoGenerateColumns="False"
                                                 SelectionChanged="gvProjects_SelectionChanged">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Width="40"
                                                                Header="ID"
                                                                DataMemberBinding="{Binding Id}" />
                                    <telerik:GridViewDataColumn Width="2*"
                                                                Header="Name"
                                                                DataMemberBinding="{Binding Name}" />
                                    <telerik:GridViewDataColumn Width="*"
                                                                Header="Date"
                                                                DataMemberBinding="{Binding DateString}" />
                                    <telerik:GridViewDataColumn Width="80" Header="Status">
                                        <telerik:GridViewDataColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center">
                                                    <Ellipse Width="12" Height="12"
                                                             Style="{StaticResource ProjectStatusColor}"
                                                             VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DataStatus}"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </telerik:GridViewDataColumn.CellTemplate>
                                    </telerik:GridViewDataColumn>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>
                        </Grid>

                        <!-- Project details (right half of Step 1) -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>

                                <TextBlock Text="Step 1 — Project setup"
                                           FontSize="14" FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{StaticResource SesTextSecondaryBrush}"
                                           Margin="0,0,0,12"
                                           Text="Create or select a project, then describe the verification. The Vessel MRU is verified against the Reference MRU."/>

                                <telerik:GroupBox Header="Project Details" Margin="0,0,0,8">
                                    <Grid Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="120" MaxWidth="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ID" VerticalAlignment="Center" Foreground="{StaticResource SesTextSecondaryBrush}"/>
                                        <Label Grid.Row="0" Grid.Column="1" Name="lbDataSetID" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Project Name" VerticalAlignment="Center" Margin="0,4,0,0" Foreground="{StaticResource SesTextSecondaryBrush}"/>
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Name="tbDataSetName"
                                                 MinHeight="32"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"
                                                 Margin="0,4,0,0"
                                                              LostFocus="tbDataSetName_LostFocus"
                                                              KeyDown="tbDataSetName_KeyDown"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Operator" VerticalAlignment="Center" Margin="0,4,0,0" Foreground="{StaticResource SesTextSecondaryBrush}"/>
                                        <telerik:RadWatermarkTextBox Grid.Row="2" Grid.Column="1"
                                                 Name="tbOperator"
                                                 MinHeight="32"
                                                 VerticalContentAlignment="Center"
                                                 Margin="0,4,0,0"
                                                 WatermarkContent="Required"
                                                 LostFocus="tbOperator_LostFocus"
                                                 KeyDown="tbOperator_KeyDown"
                                                 TextChanged="tbReportField_TextChanged"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Vessel" VerticalAlignment="Center" Margin="0,4,0,0" Foreground="{StaticResource SesTextSecondaryBrush}"/>
                                        <telerik:RadWatermarkTextBox Grid.Row="3" Grid.Column="1"
                                                 Name="tbVesselName"
                                                 MinHeight="32"
                                                 VerticalContentAlignment="Center"
                                                 Margin="0,4,0,0"
                                                 WatermarkContent="Required"
                                                 LostFocus="tbVesselName_LostFocus"
                                                 KeyDown="tbVesselName_KeyDown"
                                                 TextChanged="tbReportField_TextChanged"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Location" VerticalAlignment="Center" Margin="0,4,0,0" Foreground="{StaticResource SesTextSecondaryBrush}"/>
                                        <telerik:RadWatermarkTextBox Grid.Row="4" Grid.Column="1"
                                                 Name="tbLocation"
                                                 MinHeight="32"
                                                 VerticalContentAlignment="Center"
                                                 Margin="0,4,0,0"
                                                 WatermarkContent="Required"
                                                 LostFocus="tbLocation_LostFocus"
                                                 KeyDown="tbLocation_KeyDown"
                                                 TextChanged="tbReportField_TextChanged"/>
                                                 </Grid>
                                </telerik:GroupBox>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== STEP 2: LIDAR CORRECTION ===== -->
                    <Grid x:Name="panelStep2" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Step 2 — LiDAR correction for Reference MRU"
                                       FontSize="14" FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{StaticResource SesTextSecondaryBrush}"
                                       Margin="0,0,0,8"
                                       Text="1: Set up the LiDAR sensor. 2: Perform a scan. 3: Analyse the scan to derive pitch/roll/heading offsets. 4: Apply the correction to the Reference MRU before capturing motion data."/>
                        </StackPanel>

                        <local:LivoxLidarPage Grid.Row="1" x:Name="ucWizardLivoxLidarPage"/>
                    </Grid>

                    <!-- ===== STEP 3: CAPTURE ===== -->
                    <ScrollViewer x:Name="panelStep3" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="320"/>
                            <ColumnDefinition Width="3*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>

                        <!-- ===== LEFT: existing capture controls ===== -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">

                            <TextBlock Text="Step 3 — Capture motion data"
                                       FontSize="14" FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{StaticResource SesTextSecondaryBrush}"
                                       Margin="0,0,0,12"
                                       Text="Record live motion data for this project. The recommended verification window is at least 40 minutes."/>

                            <controls:DurationStatusBanner x:Name="durationBanner" Margin="0,0,0,12"/>

                            <telerik:GroupBox Header="Date / Duration" Margin="0,0,0,8">
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120" MaxWidth="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Date"      Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Label     Grid.Row="0" Grid.Column="1" Name="lbDataSetDate"      VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Start"     Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Label     Grid.Row="1" Grid.Column="1" Name="lbDataSetStartTime" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="End"       Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Label     Grid.Row="2" Grid.Column="1" Name="lbDataSetEndTime"   VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Duration"  Foreground="{StaticResource SesTextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Label     Grid.Row="3" Grid.Column="1" Name="lbDataSetDuration"  VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2"
                                               Name="tbDurationWarning"
                                               Text="Short recording — at least 20 minutes is recommended before analysis."
                                               Foreground="{StaticResource SesWarningTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </telerik:GroupBox>

                            <!-- Recording controls, bound to MainWindowVM via bridge element -->
                            <telerik:GroupBox Header="Recording" Margin="0,0,0,8">
                                <StackPanel Margin="8" Orientation="Vertical">

                                    <StackPanel Orientation="Horizontal">
                                        <telerik:RadButton x:Name="btnStartRecording"
                                                           Click="btnStartRecording_Click"
                                                           IsEnabled="{Binding DataContext.StartButtonEnabled, ElementName=mainWindowVMBridge}"
                                                           Content="Start Recording"
                                                           MinWidth="140"
                                                           Margin="0,0,10,0"/>
                                        <telerik:RadButton x:Name="btnStopRecording"
                                                           Click="btnStopRecording_Click"
                                                           IsEnabled="{Binding DataContext.StopButtonEnabled, ElementName=mainWindowVMBridge}"
                                                           Content="Stop"
                                                           MinWidth="100"
                                                           Margin="0,0,10,0"/>
                                        <telerik:RadButton x:Name="btnClearRecording"
                                                           Click="btnClearRecording_Click"
                                                           Content="Clear Recording"
                                                           MinWidth="140"
                                                           IsEnabled="False"/>
                                    </StackPanel>

                                </StackPanel>
                            </telerik:GroupBox>

                            </StackPanel>

                        <!-- ===== RIGHT: live input charts (Pitch / Roll / Heave) ===== -->
                        <telerik:GroupBox Grid.Column="1" Header="Live Input">
                            <local:CaptureCharts x:Name="ucCaptureCharts"
                                                 MinHeight="600"
                                                 Margin="8"/>
                        </telerik:GroupBox>
                    </Grid>
                    </ScrollViewer>

                    <!-- ===== STEP 4: REVIEW ===== -->
                    <ScrollViewer x:Name="panelStep4"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <!--
                            MinHeight is bound to the ScrollViewer's own ActualHeight so the
                            inner Grid always fills the viewport. The * row then distributes the
                            remaining space to DataAnalysis. The scrollbar only appears when
                            DataAnalysis's MinHeight forces the grid taller than the viewport.
                        -->
                        <Grid MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Step 4 — Review per-axis results"
                                       FontSize="14" FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource SesTextSecondaryBrush}"
                                       Margin="0,0,0,12"
                                       Text="Inspect reference, test and deviation statistics for each axis alongside the captured data charts. The deviation is the value this tool calculates; each card grades the quality of the captured input data &#8212; samples, vessel motion and noise &#8212; to tell you whether that calculated deviation can be trusted. Press the ? button on a card for a full explanation."/>

                            <!-- Per-axis result cards combined with their detailed charts -->
                            <local:DataAnalysis Grid.Row="2"
                                                x:Name="ucDataAnalysis"
                                                MinHeight="600"/>

                        </Grid>
                    </ScrollViewer>

                    <!-- ===== STEP 5: APPLY & REPORT ===== -->
                    <Grid x:Name="panelStep5" Visibility="Collapsed">

                       <!-- Report inputs + action buttons (full page width) -->
                       <Grid>
                           <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Step 5 &#x2014; Apply and report"
                                       FontSize="14" FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource SesTextSecondaryBrush}"
                                       Margin="0,0,0,12"
                                       Text="Fill in all required fields (*), then click Generate Report. Use Preview Report to view it in a popup window, save it as PDF, or open it directly."/>

                            <!-- Project details + report metadata for the report -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                              <StackPanel>
                            <telerik:GroupBox Header="Project Details" Margin="0,0,0,10">
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Comments" Margin="0,4,8,0" VerticalAlignment="Top" Foreground="{StaticResource SesTextSecondaryBrush}"/>
                                    <telerik:RadWatermarkTextBox Grid.Row="0" Grid.Column="1"
                                             Name="tbDataSetComments"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top"
                                             Height="60"
                                             MinHeight="60"
                                             MaxHeight="120"
                                             Margin="0,0,0,6"
                                             WatermarkContent="Optional"
                                             LostFocus="tbDataSetDescription_LostFocus"
                                             KeyDown="tbDataSetDescription_KeyDown"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Correction Applied" VerticalAlignment="Center" Margin="0,4,8,0" Foreground="{StaticResource SesTextSecondaryBrush}"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1"
                                              x:Name="chkCorrectionApplied"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="0,4,0,0"
                                              Checked="chkCorrectionApplied_Changed"
                                              Unchecked="chkCorrectionApplied_Changed"/>
                                </Grid>
                            </telerik:GroupBox>

                            <!-- Extended report metadata (equipment, setup, conditions, criteria, notes) -->
                            <telerik:GroupBox Header="Report Details" Margin="0,0,0,10">
                                <StackPanel Margin="8">
                                    <telerik:RadButton x:Name="btnInsertDefaultText"
                                                       Click="btnInsertDefaultText_Click"
                                                       Content="Insert Default Text"
                                                       HorizontalAlignment="Left"
                                                       Margin="0,0,0,8"
                                                       IsEnabled="{Binding IsEnabled, ElementName=ucReportMetadata}"/>
                                    <controls:ReportMetadataEditor x:Name="ucReportMetadata"
                                                                   MetadataChanged="ucReportMetadata_MetadataChanged"/>
                                </StackPanel>
                            </telerik:GroupBox>
                              </StackPanel>
                            </ScrollViewer>

                            <!-- Action buttons -->
                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <telerik:RadButton x:Name="btnGenerateReport"
                                                       Click="btnGenerateReport_Click"
                                                       Content="Generate Report"
                                                       MinWidth="150"/>
                                    <telerik:RadButton x:Name="btnUpdateReport"
                                                       Click="btnGenerateReport_Click"
                                                       Content="Update Report"
                                                       Visibility="Collapsed"
                                                       MinWidth="150"
                                                       Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <telerik:RadButton x:Name="btnPreviewReport"
                                                       Click="btnPreviewReport_Click"
                                                       Content="Preview Report"
                                                       IsEnabled="False"
                                                       MinWidth="140"
                                                       Margin="0,0,8,0"/>
                                    <telerik:RadButton x:Name="btnSaveReportToDisc"
                                                       Click="btnSaveReportToDisc_Click"
                                                       Content="Save Report"
                                                       IsEnabled="False"
                                                       MinWidth="120"/>
                                    <telerik:RadButton x:Name="btnOpenPdfReport"
                                                       Click="btnOpenPdfReport_Click"
                                                       Content="Open PDF Report"
                                                       IsEnabled="False"
                                                       MinWidth="140"
                                                       Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    </Grid>
                </Grid>

                <!-- Status footer -->
                <Border Grid.Row="3"
                        BorderBrush="{StaticResource SesBorderBrush}" BorderThickness="0,1,0,0"
                        Padding="0,8,0,0" Margin="0,8,0,0">
                    <TextBlock x:Name="tbAnalysisStatus"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SesTextSecondaryBrush}"
                               Text=""/>
                </Border>
    </Grid>
</UserControl>
