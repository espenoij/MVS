<telerik:RadWindow
    x:Class="MVS.DialogRecordingActive"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:local="clr-namespace:MVS"
    xmlns:controls="clr-namespace:MVS.Views.Controls"
    telerik:Header="Recording"
    WindowStartupLocation="CenterOwner"
    Height="310"
    Width="680"
    telerik:StyleManager.Theme="Material">

    <telerik:RadWindow.Icon>
        <Image
            Height="32"
            Source="../Icons/mvs_windows_icon.ico" />
    </telerik:RadWindow.Icon>

    <telerik:RadWindow.Resources>
        <ResourceDictionary>
            <Style
                TargetType="local:DialogRecordingActive"
                BasedOn="{StaticResource RadWindowStyle}" />
        </ResourceDictionary>
    </telerik:RadWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Recording status indicator (styled to match the LiDAR scanning badge) -->
        <Border Grid.Row="0"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,8,0,0" Padding="12,4" CornerRadius="4"
                Background="{StaticResource SesErrorBrush}">
            <StackPanel Orientation="Horizontal">

                <!-- Pulsing indicator -->
                <Ellipse Width="10" Height="10" Fill="{StaticResource SesWhiteBrush}" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="1.0" To="0.3" Duration="0:0:0.6"
                                                     AutoReverse="True" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <TextBlock Text="RECORDING" FontSize="12" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" />

            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="16">

            <controls:DurationStatusBanner x:Name="banner" Margin="0,0,0,16" />

            <telerik:RadButton x:Name="btnStop"
                               Click="btnStop_Click"
                               Content="Stop Recording"
                               HorizontalAlignment="Right"
                               MinWidth="140" />

        </StackPanel>
    </Grid>

</telerik:RadWindow>
