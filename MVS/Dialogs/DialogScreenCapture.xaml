<Window
    x:Class="MVS.Dialogs.DialogScreenCapture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Screen Capture"
    WindowStartupLocation="CenterScreen"
    Height="200"
    Width="400"
    Icon="pack://application:,,,/MVS;component/Icons/mvs_windows_icon.ico"
    Background="{StaticResource SesSurfaceBrush}">

    <DockPanel>

        <StackPanel
            DockPanel.Dock="Bottom"
            HorizontalAlignment="Center"
            Orientation="Horizontal">

            <Button
                Margin="8"
                Width="150"
                Content="Open File Location"
                Click="btnOpenFileLocation_Click"
                Style="{StaticResource SesNativeSecondaryButtonStyle}" />

            <Button
                Margin="8"
                Width="150"
                Content="Copy to Clipboard"
                Click="btnCopyToClipboard_Click"
                Style="{StaticResource SesNativeSecondaryButtonStyle}" />

        </StackPanel>

        <Label
            DockPanel.Dock="Top"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Content="Screen captured successfully!" />

    </DockPanel>

</Window>
