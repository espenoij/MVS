<telerik:RadWindow
    x:Class="MVS.DialogAbout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:local="clr-namespace:MVS"
    telerik:Header="About"
    WindowStartupLocation="CenterScreen"
    Height="870"
    Width="700"
    telerik:StyleManager.Theme="Material">

    <telerik:RadWindow.Icon>
        <Image
            Height="32"
            Source="../Icons/mvs_windows_icon.ico" />
    </telerik:RadWindow.Icon>

    <telerik:RadWindow.Resources>
        <ResourceDictionary>
            <Style
                TargetType="local:DialogAbout"
                BasedOn="{StaticResource RadWindowStyle}" />
        </ResourceDictionary>
    </telerik:RadWindow.Resources>

    <DockPanel>

        <StackPanel
            DockPanel.Dock="Bottom"
            HorizontalAlignment="Center">

            <telerik:Label
                HorizontalAlignment="Center"
                FontFamily="{StaticResource SesFontFamily}"
                Foreground="{StaticResource SesTextSecondaryBrush}"
                Content="{Binding Path=aboutCopyright}" />

            <telerik:RadButton
                Margin="8"
                Width="150"
                HorizontalAlignment="Center"
                Style="{StaticResource SesSecondaryButtonStyle}"
                Content="Close"
                Click="btnActivate_Click" />

        </StackPanel>

        <StackPanel>

            <StackPanel
                Background="{StaticResource SesDarkBlueGreyBrush}">

                <Image
                    DockPanel.Dock="Top"
                    HorizontalAlignment="Center"
                    Margin="0,24,0,0"
                    Width="50"
                    Source="../Icons/mvs_windows_icon.ico" />

                <telerik:Label
                    DockPanel.Dock="Top"
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource SesFontSizePageTitle}"
                    FontFamily="{StaticResource SesFontFamily}"
                    FontWeight="Bold"
                    Foreground="{StaticResource SesWhiteBrush}"
                    Content="MVS" />

                <Separator
                    VerticalAlignment="Bottom"
                    Background="{StaticResource SesEnergyGreenBrush}"
                    Width="400" />

                <telerik:Label
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource SesFontSizeSubHeader}"
                    FontFamily="{StaticResource SesFontFamily}"
                    Foreground="{StaticResource SesWhiteBrush}"
                    DockPanel.Dock="Top"
                    Margin="0,0,0,24"
                    Content="Motion Verification System" />

            </StackPanel>

            <Image
                HorizontalAlignment="Center"
                Margin="0,20,0,20"
                Width="350"
                Source="../Icons/helifuel_logo.png" />

            <!--SOFTWARE-->
            <telerik:GroupBox
                Header="Software"
                DockPanel.Dock="Top"
                Margin="8">

                <StackPanel>

                    <!--Software Name-->
                    <DockPanel>

                        <telerik:Label
                            Width="200"
                            Content="Name" />

                        <telerik:Label
                            Content="{Binding Path=softwareName}" />

                    </DockPanel>

                    <!--Software Version-->
                    <DockPanel>

                        <telerik:Label
                            Width="200"
                            Content="Version" />

                        <telerik:Label
                            Content="{Binding Path=softwareVersion}" />

                    </DockPanel>

                </StackPanel>

            </telerik:GroupBox>

            <!--Support-->
            <telerik:GroupBox
                Header="Support"
                Margin="8">

                <StackPanel>

                    <!--Info-->
                    <telerik:Label
                        Content="{Binding Path=aboutSupport}"
                        Margin="8" />

                    <!--QR Codes-->
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--Website QR Code-->
                        <StackPanel
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            Margin="8">

                            <ContentControl
                                x:Name="websiteBarcodeHost"
                                Width="120"
                                Height="120" />

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="4">

                                <!--Website Icon-->
                                <TextBlock
                                    Text="&#xE774;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="16"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"
                                    Foreground="{StaticResource SesEnergyGreenBrush}" />

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11">
                                    <Hyperlink
                                        NavigateUri="https://sesenergy.com/aviation"
                                        RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="sesenergy.com/aviation" />
                                    </Hyperlink>
                                </TextBlock>

                            </StackPanel>

                        </StackPanel>

                        <!--Email QR Code-->
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            Margin="8">

                            <ContentControl
                                x:Name="emailBarcodeHost"
                                Width="120"
                                Height="120" />

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="4">

                                <!--Email Icon-->
                                <TextBlock
                                    Text="&#xE715;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="16"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"
                                    Foreground="{StaticResource SesEnergyGreenBrush}" />

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11">
                                    <Hyperlink
                                        NavigateUri="mailto:aviation.services@sesenergy.com"
                                        RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="aviation.services@sesenergy.com" />
                                    </Hyperlink>
                                </TextBlock>

                            </StackPanel>

                        </StackPanel>

                    </Grid>

                </StackPanel>

            </telerik:GroupBox>

        </StackPanel>

    </DockPanel>

</telerik:RadWindow>
