<Window
    x:Class="MVS.DialogHandlerWarning"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Warning"
    WindowStartupLocation="CenterScreen"
    SizeToContent="WidthAndHeight"
    MaxWidth="600"
    MinWidth="400"
    Icon="pack://application:,,,/MVS;component/Icons/mvs_windows_icon.ico"
    Background="{StaticResource SesSurfaceBrush}">

    <DockPanel
        Margin="8,8,8,0">

        <Button
            DockPanel.Dock="Bottom"
            x:Name="btnClose"
            Margin="8"
            Width="110"
            Content="Close"
            Click="btnClose_Click"
            Style="{StaticResource SesNativeSecondaryButtonStyle}" />

        <Image
            Width="48"
            Margin="16"
            VerticalAlignment="Top"
            Source="../Icons/outline_error_outline_black_48dp.png" />

        <TextBlock
            DockPanel.Dock="Top"
            Name="tbHeader"
            Margin="16"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            TextWrapping="Wrap" />

        <TextBlock
            DockPanel.Dock="Top"
            Name="tbText"
            Margin="16"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            TextWrapping="Wrap" />

    </DockPanel>

</Window>
