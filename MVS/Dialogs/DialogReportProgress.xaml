<Window
    x:Class="MVS.DialogReportProgress"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Generating Report"
    WindowStartupLocation="CenterScreen"
    Height="200"
    Width="500"
    Icon="pack://application:,,,/MVS;component/Icons/mvs_windows_icon.ico"
    Background="{StaticResource SesSurfaceBrush}">

    <StackPanel
        Margin="8">

        <TextBlock
            x:Name="lblStatus"
            Text="Generating the verification report..." />

        <ProgressBar
            Name="reportProgressBar"
            IsIndeterminate="True"
            Orientation="Horizontal"
            Height="30"
            Margin="0,8,0,0"
            Background="{StaticResource ColorBackgroundSeparatorDark}"
            Foreground="{StaticResource ColorGreen}" />

        <TextBlock
            Text="This can take a moment for larger data sets."
            Foreground="{StaticResource SesTextSecondaryBrush}"
            Margin="0,8,0,0" />

    </StackPanel>

</Window>
